c̲o̲m̲m̲e̲n̲t̲ The procedures of the Revised Report, section 5.4.2, and its
for statement example of 4.6.2;
b̲e̲g̲i̲n̲
    p̲r̲o̲c̲e̲d̲u̲r̲e̲ Spur(a) Order:(n) Result:(s); v̲a̲l̲u̲e̲ n;
        a̲r̲r̲a̲y̲ a; i̲n̲t̲e̲g̲e̲r̲ n; r̲e̲a̲l̲ s;
    b̲e̲g̲i̲n̲ i̲n̲t̲e̲g̲e̲r̲ k;
        s := 0;
        f̲o̲r̲ k := 1 s̲t̲e̲p̲ 1 u̲n̲t̲i̲l̲ n d̲o̲ s := s + a[k, k]
    e̲n̲d̲;

    p̲r̲o̲c̲e̲d̲u̲r̲e̲ Transpose(a) Order:(n); v̲a̲l̲u̲e̲ n;
        a̲r̲r̲a̲y̲ a; i̲n̲t̲e̲g̲e̲r̲ n;
    b̲e̲g̲i̲n̲ r̲e̲a̲l̲ w; i̲n̲t̲e̲g̲e̲r̲ i, k;
        f̲o̲r̲ i := 1 s̲t̲e̲p̲ 1 u̲n̲t̲i̲l̲ n d̲o̲
            f̲o̲r̲ k := 1 + i s̲t̲e̲p̲ 1 u̲n̲t̲i̲l̲ n d̲o̲
            b̲e̲g̲i̲n̲ w := a[i, k]; a[i, k] := a[k, i]; a[k, i] := w e̲n̲d̲
    e̲n̲d̲ Transpose;

    i̲n̲t̲e̲g̲e̲r̲ p̲r̲o̲c̲e̲d̲u̲r̲e̲ Step(u); r̲e̲a̲l̲ u;
        Step := i̲f̲ 0 ≤ u ∧ u ≤ 1 t̲h̲e̲n̲ 1 e̲l̲s̲e̲ 0;

    p̲r̲o̲c̲e̲d̲u̲r̲e̲ Absmax(a) Size:(n, m) Result:(y) Subscripts:(i, k);
        c̲o̲m̲m̲e̲n̲t̲ The absolute greatest element of the matrix a, of size n by
        m, is transferred to y, and the subscripts of this element to i and k;
        a̲r̲r̲a̲y̲ a; i̲n̲t̲e̲g̲e̲r̲ n, m, i, k; r̲e̲a̲l̲ y;
    b̲e̲g̲i̲n̲ i̲n̲t̲e̲g̲e̲r̲ p, q;
        y := 0;
        f̲o̲r̲ p := 1 s̲t̲e̲p̲ 1 u̲n̲t̲i̲l̲ n d̲o̲
            f̲o̲r̲ q := 1 s̲t̲e̲p̲ 1 u̲n̲t̲i̲l̲ m d̲o̲
                i̲f̲ abs(a[p, q]) > y t̲h̲e̲n̲
                b̲e̲g̲i̲n̲ y := abs(a[p, q]); i := p; k := q e̲n̲d̲
    e̲n̲d̲ Absmax;

    p̲r̲o̲c̲e̲d̲u̲r̲e̲ Innerproduct(a, b) Order:(k, p) Result:(y); v̲a̲l̲u̲e̲ k;
        i̲n̲t̲e̲g̲e̲r̲ k, p; r̲e̲a̲l̲ y, a, b;
    b̲e̲g̲i̲n̲ r̲e̲a̲l̲ s;
        s := 0;
        f̲o̲r̲ p := 1 s̲t̲e̲p̲ 1 u̲n̲t̲i̲l̲ k d̲o̲ s := s + a × b;
        y := s
    e̲n̲d̲ Innerproduct;

    p̲r̲o̲c̲e̲d̲u̲r̲e̲ euler(fct, sum, eps, tim); v̲a̲l̲u̲e̲ eps, tim; i̲n̲t̲e̲g̲e̲r̲ tim;
        r̲e̲a̲l̲ p̲r̲o̲c̲e̲d̲u̲r̲e̲ fct; r̲e̲a̲l̲ sum, eps;
        c̲o̲m̲m̲e̲n̲t̲ euler computes the sum of fct(i) for i from zero up to
        infinity by means of a suitably refined euler transformation;
    b̲e̲g̲i̲n̲ i̲n̲t̲e̲g̲e̲r̲ i, k, n, t; a̲r̲r̲a̲y̲ m[0:15]; r̲e̲a̲l̲ mn, mp, ds;
        i := n := t := 0; m[0] := fct(0); sum := m[0] / 2;
    nextterm: i := i + 1; mn := fct(i);
        f̲o̲r̲ k := 0 s̲t̲e̲p̲ 1 u̲n̲t̲i̲l̲ n d̲o̲
        b̲e̲g̲i̲n̲ mp := (mn + m[k]) / 2; m[k] := mn; mn := mp e̲n̲d̲ means;
        i̲f̲ (abs(mn) < abs(m[n])) ∧ (n < 15) t̲h̲e̲n̲
        b̲e̲g̲i̲n̲ ds := mn / 2; n := n + 1; m[n] := mn e̲n̲d̲ accept
        e̲l̲s̲e̲ ds := mn;
        sum := sum + ds;
        i̲f̲ abs(ds) < eps t̲h̲e̲n̲ t := t + 1 e̲l̲s̲e̲ t := 0;
        i̲f̲ t < tim t̲h̲e̲n̲ g̲o̲t̲o̲ nextterm
    e̲n̲d̲ euler;

    r̲e̲a̲l̲ p̲r̲o̲c̲e̲d̲u̲r̲e̲ alternating(i); v̲a̲l̲u̲e̲ i; i̲n̲t̲e̲g̲e̲r̲ i;
        alternating := (i̲f̲ i ÷ 2 × 2 = i t̲h̲e̲n̲ 1 e̲l̲s̲e̲ -1) / (i + 1);

    a̲r̲r̲a̲y̲ A[1:3, 1:3], B[1:4, 1:5], V[1:10], W[1:10];
    i̲n̲t̲e̲g̲e̲r̲ i, j, t, p, q; r̲e̲a̲l̲ s, y, sum;

    f̲o̲r̲ i := 1 s̲t̲e̲p̲ 1 u̲n̲t̲i̲l̲ 3 d̲o̲
        f̲o̲r̲ j := 1 s̲t̲e̲p̲ 1 u̲n̲t̲i̲l̲ 3 d̲o̲ A[i, j] := 10 × i + j;
    Spur(A) Order:(3) Result:(s);
    outreal(1, s);
    Transpose(A) Order:(3);
    outreal(1, A[1, 3]); outreal(1, A[3, 1]);

    outinteger(1, Step(0.5)); outinteger(1, Step(1)); outinteger(1, Step(1.5));
    outinteger(1, Step(-0.1));

    f̲o̲r̲ i := 1 s̲t̲e̲p̲ 1 u̲n̲t̲i̲l̲ 4 d̲o̲
        f̲o̲r̲ j := 1 s̲t̲e̲p̲ 1 u̲n̲t̲i̲l̲ 5 d̲o̲ B[i, j] := (i - 2.5) × (j - 3.2);
    Absmax(B) Size:(4, 5) Result:(y) Subscripts:(p, q);
    outreal(1, y); outinteger(1, p); outinteger(1, q);

    f̲o̲r̲ i := 1 s̲t̲e̲p̲ 1 u̲n̲t̲i̲l̲ 10 d̲o̲ b̲e̲g̲i̲n̲ V[i] := i; W[i] := 11 - i e̲n̲d̲;
    Innerproduct(V[t], W[t]) Order:(10, t) Result:(y);
    outreal(1, y);

    euler(alternating, sum, 1⏨-10, 3);
    outstring(1, i̲f̲ abs(sum - ln(2)) < 1⏨-9 t̲h̲e̲n̲ `euler ln 2 ok ' e̲l̲s̲e̲ `euler wrong ');

    c̲o̲m̲m̲e̲n̲t̲ The for statement of 4.6.2;
    f̲o̲r̲ q := 1 s̲t̲e̲p̲ 1 u̲n̲t̲i̲l̲ 3, 7, 11 s̲t̲e̲p̲ 3 u̲n̲t̲i̲l̲ 16, 20 d̲o̲ outinteger(1, q)
e̲n̲d̲
