externals:
  - {kind: code, name: "CP", id: 1}
block:
  kind: block
  loc: 4/2
  decls:
    - {kind: var, name: "I", id: 2, type: integer}
    - {kind: var, name: "X", id: 3, type: real}
    - kind: arrays
      type: integer
      arrays:
        - {name: "IA", id: 4}
      bounds:
        - lower: {kind: int_const, type: integer, value: 1}
          upper: {kind: int_const, type: integer, value: 3}
  body:
    - kind: call
      loc: 6/1
      proc: 1
      name: "CP"
      args:
        - kind: element
          type: integer
          array: 4
          name: "IA"
          subscripts:
            - {kind: int_const, type: integer, value: 1}
    - kind: call
      loc: 6/2
      proc: 1
      name: "CP"
      args:
        - {kind: var, type: integer, decl: 4, name: "IA"}
    - kind: call
      loc: 6/3
      proc: 1
      name: "CP"
      args:
        - {kind: var, type: none, decl: 1, name: "CP"}
    - kind: call
      loc: 6/4
      proc: 1
      name: "CP"
      args:
        - kind: binary
          type: string
          op: add
          left: {kind: string_const, type: string, value: "S"}
          right: {kind: string_const, type: string, value: "T"}
    - kind: io
      loc: 7/1
      op: read
      params: []
      items:
        - kind: item
          expr: {kind: var, type: integer, decl: 2, name: "I"}
    - kind: io
      loc: 7/2
      op: read
      params: []
      items:
        - kind: item
          expr:
            kind: element
            type: integer
            array: 4
            name: "IA"
            subscripts:
              - {kind: int_const, type: integer, value: 1}
    - kind: io
      loc: 7/3
      op: read
      params: []
      items:
        - kind: item
          expr: {kind: var, type: integer, decl: 4, name: "IA"}
    - kind: io
      loc: 7/4
      op: read
      params: []
      items: []
    - kind: std_proc
      loc: 8/1
      proc: load
      args:
        - {kind: var, type: integer, decl: 2, name: "I"}
    - kind: for
      loc: 9/1
      control: {kind: var, decl: 2, name: "I"}
      elements:
        - kind: step_until
          init: {kind: int_const, type: integer, value: 1}
          step: {kind: int_const, type: integer, value: 1}
          until: {kind: var, type: integer, decl: 2, name: "I"}
      body:
        kind: assign
        loc: 9/2
        targets:
          - {kind: var, decl: 3, name: "X"}
        value:
          kind: convert
          type: real
          conv: int_to_real
          expr: {kind: int_const, type: integer, value: 1}
