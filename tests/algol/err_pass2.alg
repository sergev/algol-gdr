_comment TYPE AND USE ERRORS FOUND BY PASS 2;
_code: CP;
_algol: AP;
_begin _integer I; _real X; _boolean B;
  _integer _array IA[1:3]; _real _array RA[1:3];
  _boolean _array BA[1:3];
  _switch S := L, M;
  _integer _procedure IP(N); _value N; _integer N; IP := N;
  _real _procedure RP; RP := 1;
  _boolean _procedure BP; BP := _true;
  _procedure P0; ;
  _procedure PP(A1, A2, A3, A4, A5, A6, A7, A8);
    _value A1; _integer A1; _real A2; _boolean A3; _array A4;
    _label A5; _procedure A6; _string A7; _switch A8;
  _begin A2 := A1 _end;
L: I := 1;
M: X := 1;
  I := PP;
  I := IA;
  I := AP;
  I := I _lt X;
  I := IP(X);
  I := IP(B);
  I := IA[B];
  I := IA[1,2];
  I := `S'+`T';
  IP(1) := 1;
  IA := 1;
  LENGTH := 1;
  I := X := I;
  _for I := B _step 1 _until 2 _do X := 1;
  _for B := 1 _step 1 _until 2 _do X := 1;
  _goto I;
  IA[P0] := 1;
  I := _not B + 1;
  I := _if B _then B _else B + 1;
  B := B _lt 1;
  B := 1 _lt B;
  B := 1 _lt P0;
  X := B _power 2;
  PRINT(P0);
  PRINT(PP);
  PUNCH(S);
  I := LENGTH(I);
  CP(P0);
  CP(PP);
  X := SIN(B);
  X := -B;
  STOP(I);
  ASSIGN(I);
  PP(1, I, B, RA, L, P0, `S', S);
  PP(1, X, B, RA, CP, P0, `S', S)
_end
