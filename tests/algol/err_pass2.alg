'COMMENT' TYPE AND USE ERRORS FOUND BY PASS 2;
'CODE': CP;
'ALGOL': AP;
'BEGIN' 'INTEGER' I; 'REAL' X; 'BOOLEAN' B;
  'INTEGER' 'ARRAY' IA[1:3]; 'REAL' 'ARRAY' RA[1:3];
  'BOOLEAN' 'ARRAY' BA[1:3];
  'SWITCH' S := L, M;
  'INTEGER' 'PROCEDURE' IP(N); 'VALUE' N; 'INTEGER' N; IP := N;
  'REAL' 'PROCEDURE' RP; RP := 1;
  'BOOLEAN' 'PROCEDURE' BP; BP := 'TRUE';
  'PROCEDURE' P0; ;
  'PROCEDURE' PP(A1, A2, A3, A4, A5, A6, A7, A8);
    'VALUE' A1; 'INTEGER' A1; 'REAL' A2; 'BOOLEAN' A3; 'ARRAY' A4;
    'LABEL' A5; 'PROCEDURE' A6; 'STRING' A7; 'SWITCH' A8;
  'BEGIN' A2 := A1 'END';
L: I := 1;
M: X := 1;
  I := PP;
  I := IA;
  I := AP;
  I := I 'LT' X;
  I := IP(X);
  I := IP(B);
  I := IA[B];
  I := IA[1,2];
  I := ''S''+''T'';
  IP(1) := 1;
  IA := 1;
  LENGTH := 1;
  I := X := I;
  'FOR' I := B 'STEP' 1 'UNTIL' 2 'DO' X := 1;
  'FOR' B := 1 'STEP' 1 'UNTIL' 2 'DO' X := 1;
  'GOTO' I;
  IA[P0] := 1;
  I := 'NOT' B + 1;
  I := 'IF' B 'THEN' B 'ELSE' B + 1;
  B := B 'LT' 1;
  B := 1 'LT' B;
  B := 1 'LT' P0;
  X := B 'POWER' 2;
  PRINT(P0);
  PRINT(PP);
  PUNCH(S);
  I := LENGTH(I);
  CP(P0);
  CP(PP);
  X := SIN(B);
  X := -B;
  STOP(I);
  ASSIGN(I);
  PP(1, I, B, RA, L, P0, ''S'', S);
  PP(1, X, B, RA, CP, P0, ''S'', S)
'END'
'EOP'
