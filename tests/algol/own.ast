externals: []
block:
  kind: block
  loc: 1/1
  decls:
    - {kind: var, line: 3, name: "N", id: 1, type: integer, own: true}
  body:
    - kind: assign
      loc: 4/1
      targets:
        - {kind: var, decl: 1, name: "N"}
      value: {kind: int_const, type: integer, value: 1}
    - kind: io
      loc: 5/1
      op: print
      params: []
      items:
        - kind: item
          expr: {kind: var, type: integer, decl: 1, name: "N"}
        - {kind: new_line}
