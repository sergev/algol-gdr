A L G O L - Г Д P
    (7.01.82)

     1.      _begin_string_array L[1:7];_integer I,J;_string Q,R,S;
     2.      _procedure P(S);_string S;_begin_for J:=1_step 1_until
     3.      length(S)_do PRINT(_if J_ne 45_and S[J] = `/' _then Q
     4.      _else S[J]); PRINT(NEWLINE) _end; R := `1234567';
     5.      L[1]:=`/BEGIN//STRING//ARRAY/L[1:7];/INTEGER/I,J;/STRING/Q,R,S;';
     6.      L[2]:=`/PROCEDURE/P(S);/STRING/S;/BEGIN//FOR/J:=1/STEP/1/UNTIL/';
     7.      L[3]:=`LENGTH(S)/DO/PRINT(/IF/J/NE/45/AND/S[J] = ///// /THEN/ Q';
     8.      L[4]:=`/ELSE/ S[J]); PRINT(NEWLINE) /END/; R := //1234567//;';
     9.      L[5]:=`Q:=///47///;/FOR/ I:=1,2,3,4/DO/P(L[I]); /FOR/I:=1,2,3,4,';
    10.      L[6]:=`5,6,7/DO/PRINT(//L[//,R[I],//]:=//,Q,Q,L[I],Q,Q,//;//,';
    11.      L[7]:=`NEWLINE);/FOR/ I:=5,6,7 /DO/ P(L[I]); /END//EOP/';
    12.      Q:=‘'’;_for I:=1,2,3,4_do P(L[I]); _for I:=1,2,3,4,
    13.      5,6,7_do PRINT(`L[',R[I],`]:=',Q,Q,L[I],Q,Q,`;',
    14.      NEWLINE);_for I:=5,6,7 _do P(L[I]); _end

