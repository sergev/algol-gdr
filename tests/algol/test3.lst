A L G O L - Г Д P
    (7.01.82)

     1.     _begin
     2.         _comment SWITCHES, GOTO, BOOLEANS, WHILE, BLOCKS, ARRAYS, STRINGS;
     3.         _switch S := L1, L2, L3;
     4.         _integer I, K; _boolean B, C;
     5.         _array A[0:4, -1:1];
     6.         _procedure P(N, M); _value N; _integer N; _array M;
     7.             M[N, 0] := N + 0.5;
     8.         I := 1;
     9.     L0: _goto S[I];
    10.     L1: I := I + 1; _goto L0;
    11.     L2: I := I + 1; _goto L0;
    12.     L3: B := I = 3 _and _not (I > 5) _or _false;
    13.         C := B _impl _true _equiv _not B;
    14.         K := 0;
    15.         _for I := 1, 2, 5 _step 2 _until 9 _do K := K + 1;
    16.         _begin _integer _array X[1:K];
    17.             _for I := 1 _step 1 _until K _do X[I] := I * I;
    18.             print(X[K], NEWLINE)
    19.         _end;
    20.         _for I := 0 _step 1 _until 4 _do P(I, A);
    21.         print(A[4, 0], B, C, K, NEWLINE);
    22.         print(`HELLO FROM ALGOL', NEWLINE)
    23.     _end

