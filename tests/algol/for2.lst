A L G O L - Г Д P
    (7.01.82)

     1.     _comment FOR LOOPS REWRITTEN BY PASS 3, AND LOOPS IT GIVES UP ON;
     2.     _begin _integer I, J, K; _boolean B;
     3.       _integer _array IA[-10:20];
     4.       _procedure SHOW;
     5.       _begin _for K := -10 _step 1 _until 20 _do PRINT(IA[K]);
     6.         _for K := -10 _step 1 _until 20 _do IA[K] := 0
     7.       _end;
     8.       J := 1; B := _true;
     9.       _for K := -10 _step 1 _until 20 _do IA[K] := 0;
    10.       _for I := 1 _step 1 _until 3 _do IA[I] := I;
    11.       _for I := 1 _step 1 _until 3 _do IA[I+1] := IA[I]; SHOW;
    12.       _for I := 1 _step 1 _until 3 _do IA[2*I-1] := I;
    13.       _for I := 1 _step 1 _until 3 _do IA[-I+5] := I+10;
    14.       _for I := 1 _step 1 _until 3 _do IA[I-J] := I+20; SHOW;
    15.       _for I := 1 _step 1 _until 3 _do _if B _then IA[I] := I;
    16.       _for I := 1 _step 1 _until 3 _do IA[3-I] := I+10;
    17.       _for I := 1 _step 1 _until 3 _do IA[1] := I; SHOW;
    18.       _for I := 1 _step 1 _until 3 _do _if B _then _goto L1;
    19.     L1: PRINT(I);
    20.       _for I := 1 _step 1 _until 3 _do _goto L2;
    21.     L2: PRINT(I);
    22.       _for I := 1 _step 1 _until 3 _do I := I; PRINT(I);
    23.       _for I := 1 _step 1 _until 3 _do
    24.       _begin L3: IA[I] := IA[I] + 1;
    25.         _if IA[I] _lt 3 _then _goto L3
    26.       _end;
    27.       _for I := 1 _step 1 _until 3 _do
    28.         _if J _lt 2 _then IA[I+3] := I;
    29.       SHOW;
    30.       _for I := 3 _step -1 _until 1 _do IA[I] := I;
    31.       _for I := 3 _step -1 _until 1 _do IA[(I+1)+(I+2)] := I; SHOW;
    32.       _for I := 1 _step J _until 3 _do IA[I+1] := IA[I]+1;
    33.       _for I := 1 _step J _until 3 _do _if B _then IA[I+5] := I; SHOW;
    34.       _for I := 1 _step 1 _until 3 _do IA[(I+1)-(I+2)] := I;
    35.       _for I := 1 _step 1 _until 3 _do IA[(I-1)*(2+1)] := I+10;
    36.       _for I := 1 _step 1 _until 3 _do IA[1+2] := I+20; SHOW;
    37.       _for I := 1 _step 1 _until 3 _do IA[I+(2-1)] := I;
    38.       _for I := 1 _step 1 _until 3 _do IA[I+2*3] := I+10;
    39.       _for I := 1 _step 1 _until 3 _do IA[I*(-2)] := I+20;
    40.       _for I := 1 _step 1 _until 3 _do IA[2-I+5] := I+30; SHOW
    41.     _end
    42.     _eop

