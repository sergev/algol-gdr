A L G O L - Г Д P
    (7.01.82)

     1.     _begin
     2.         _comment STRING VARIABLES, ARRAYS, length AND INDEXING;
     3.         _string S, T;
     4.         _string _array A[1:2];
     5.         _integer I;
     6.         S := `ABCDEF';
     7.         T := S;
     8.         A[1] := `XY'; A[2] := S;
     9.         print(length(S), length(A[1]), NEWLINE);
    10.         _for I := 1 _step 1 _until length(S) _do print(S[I]);
    11.         print(T, A[1], A[2], NEWLINE)
    12.     _end

