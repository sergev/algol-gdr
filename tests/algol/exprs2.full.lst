*NAME EXPRS2
*CALL SETFTN:ONE,LONG
*PUNCH
*FULL
*ALGOL
                                             04 ИЮЛ 24 23.45
A L G O L - Г Д P
    (7.01.82)

     1.     ′COMMENT′ FOR LIST ELEMENTS, SECOND PART;
     2.     ′BEGIN′ ′INTEGER′ I, J; ′REAL′ X; ′BOOLEAN′ B;
     3.       ′INTEGER′ ′ARRAY′ IA[1:3]; ′REAL′ ′ARRAY′ RA[1:3];
     4.       ′BOOLEAN′ ′ARRAY′ BA[1:3];
     5.       ′SWITCH′ S := L, M;
     6.       ′INTEGER′ ′PROCEDURE′ IP(N); ′VALUE′ N; ′INTEGER′ N; IP := N;
     7.       ′REAL′ ′PROCEDURE′ RP; RP := 1;
     8.       ′BOOLEAN′ ′PROCEDURE′ BP; BP := ′TRUE′;
     9.       ′PROCEDURE′ P0; ;
    10.       ′PROCEDURE′ PP(A1, A2, A3, A4, A5, A6, A7, A8);
    11.         ′VALUE′ A1; ′INTEGER′ A1; ′REAL′ A2; ′BOOLEAN′ A3; ′ARRAY′ A4;
    12.         ′LABEL′ A5; ′PROCEDURE′ A6; ′STRING′ A7; ′SWITCH′ A8;
    13.       ′BEGIN′ A2 := A1 ′END′;
    14.     L: I := 1;
    15.     M: X := 1;
    16.       I := 1; J := 2; X := 2; B := ′TRUE′;
    17.       IA[1] := 1; IA[2] := 2; IA[3] := 3;
    18.       ′FOR′ I := I+I ′STEP′ 1 ′UNTIL′ 2 ′DO′ X := 1; PRINT(I);
    19.       ′FOR′ I := ′IF′ B ′THEN′ I ′ELSE′ X ′STEP′ 1 ′UNTIL′ 2 ′DO′ X := 1;
    20.       PRINT(I);
    21.       ′FOR′ I := ABS(I) ′STEP′ 1 ′UNTIL′ 2 ′DO′ X := 1; PRINT(I);
    22.       ′FOR′ I := 1 ′STEP′ I ′UNTIL′ 2 ′DO′ X := 1; PRINT(I);
    23.       ′FOR′ I := 1 ′STEP′ IA[1] ′UNTIL′ 2 ′DO′ X := 1; PRINT(I);
    24.       ′FOR′ I := 1 ′STEP′ IA[X] ′UNTIL′ 2 ′DO′ X := 1; PRINT(I);
    25.       ′FOR′ I := 1 ′STEP′ 1 ′UNTIL′ J ′DO′ X := 1; PRINT(I);
    26.       ′FOR′ X := 1 ′STEP′ 1 ′UNTIL′ 2 ′DO′ I := 1; PRINT(X)
    27.     ′END′
    28.     ′EOP′

