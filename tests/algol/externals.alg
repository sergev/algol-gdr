'COMMENT' CALLS OF 'CODE' PROCEDURES, READ AND LOAD, A LOOP THAT
    NEVER ENDS;
'CODE': CP;
'BEGIN' 'INTEGER' I; 'REAL' X;
  'INTEGER' 'ARRAY' IA[1:3];
  CP(IA[1]); CP(IA); CP(CP); CP(''S''+''T'');
  READ(I); READ(IA[1]); READ(IA); READ(LENGTH);
  LOAD(I);
  'FOR' I := 1 'STEP' 1 'UNTIL' I 'DO' X := 1
'END'
'EOP'
