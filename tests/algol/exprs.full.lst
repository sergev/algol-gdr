A L G O L - Г Д P
    (7.01.82)
           1. ′COMMENT′ FOR LIST ELEMENTS, CONDITIONAL AND P
               OWER EXPRESSIONS;
           2. ′BEGIN′ ′INTEGER′ I; ′REAL′ X; ′BOOLEAN′ B;
           3.   ′INTEGER′ ′ARRAY′ IA[1:3]; ′REAL′ ′ARRAY′ RA
               [1:3];
           4.   ′BOOLEAN′ ′ARRAY′ BA[1:3];
           5.   ′SWITCH′ S := L, M;
           6.   ′INTEGER′ ′PROCEDURE′ IP(N); ′VALUE′ N; ′INT
               EGER′ N; IP := N;
           7.   ′REAL′ ′PROCEDURE′ RP; RP := 1;
           8.   ′BOOLEAN′ ′PROCEDURE′ BP; BP := ′TRUE′;
           9.   ′PROCEDURE′ P0; ;
          10.   ′PROCEDURE′ PP(A1, A2, A3, A4, A5, A6, A7, A
               8);
          11.     ′VALUE′ A1; ′INTEGER′ A1; ′REAL′ A2; ′BOOL
               EAN′ A3; ′ARRAY′ A4;
          12.     ′LABEL′ A5; ′PROCEDURE′ A6; ′STRING′ A7; ′
               SWITCH′ A8;
          13.   ′BEGIN′ A2 := A1 ′END′;
          14. L: I := 1;
          15. M: X := 1;
          16.   I := 1; X := 2; B := ′TRUE′;
          17.   IA[1] := 1; IA[2] := 2; IA[3] := 3;
          18.   I := IA[X]; PRINT(I);
          19.   I := ′IF′ B ′THEN′ I ′ELSE′ X; PRINT(I);
          20.   B := X ′LT′ 1; PRINT(B);
          21.   B := X ′EQUAL′ 1; PRINT(B);
          22.   X := 2 ′POWER′ I; PRINT(X);
          23.   X := 2 ′POWER′ IP(1); PRINT(X);
          24.   PRINT(IA);
          25.   ′FOR′ I := I ′STEP′ 1 ′UNTIL′ 2 ′DO′ X := 1;
                PRINT(I);
          26.   ′FOR′ I := X ′STEP′ 1 ′UNTIL′ 2 ′DO′ X := 1;
                PRINT(I);
          27.   ′FOR′ I := IA[1] ′STEP′ 1 ′UNTIL′ 2 ′DO′ X :
               = 1; PRINT(I);
          28.   ′FOR′ I := RP ′STEP′ 1 ′UNTIL′ 2 ′DO′ X := 1
               ; PRINT(I);
          29.   ′FOR′ I := 1.5 ′STEP′ 1 ′UNTIL′ 2 ′DO′ X :=
               1; PRINT(I);
          30.   ′FOR′ I := -I ′STEP′ 1 ′UNTIL′ 2 ′DO′ X := 1
               ; PRINT(I)
          31. ′END′
          32. ′EOP′
