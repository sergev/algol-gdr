A L G O L - Г Д P
    (7.01.82)

     1.     _begin
     2.         _comment FOR STATEMENTS: STEP-UNTIL, WHILE, LISTS;
     3.         _integer I, S;
     4.         _real X;
     5.         S := 0;
     6.         _for I := 1 _step 1 _until 10 _do S := S + I;
     7.         print(S, NEWLINE);
     8.         _for I := 10 _step -3 _until 0 _do print(I, NEWLINE);
     9.         _for I := 5 _step 1 _until 4 _do print(-1, NEWLINE);
    10.         S := 1;
    11.         _for I := S * 2 _while S < 100 _do S := I;
    12.         print(S, NEWLINE);
    13.         _for I := 1, 3, 7, 10 _step 5 _until 20, S _do print(I, NEWLINE);
    14.         _for X := 0.5 _step 0.25 _until 1.0 _do print(X, NEWLINE);
    15.         print(I, NEWLINE)
    16.     _end

