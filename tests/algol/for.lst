A L G O L - Г Д P
    (7.01.82)

     1.     _begin
     2.         _comment FOR STATEMENTS: STEP-UNTIL, WHILE, LISTS;
     3.         _integer I, S;
     4.         _real X;
     5.         S := 0;
     6.         _for I := 1 _step 1 _until 10 _do S := S + I;
     7.         PRINT(S);
     8.         _for I := 10 _step -3 _until 0 _do PRINT(I);
     9.         _for I := 5 _step 1 _until 4 _do PRINT(-1);
    10.         S := 1;
    11.         _for I := S * 2 _while S < 100 _do S := I;
    12.         PRINT(S);
    13.         _for I := 1, 3, 7, 10 _step 5 _until 20, S _do PRINT(I);
    14.         _for X := 0.5 _step 0.25 _until 1.0 _do PRINT(X);
    15.         PRINT(I)
    16.     _end
    17.     _eop

