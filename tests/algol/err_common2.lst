A L G O L - Г Д P
    (7.01.82)

     1.     _comment _common ELEMENTS DECLARED OUT OF ORDER, NOT DECLARED,
     2.         OR DECLARED AS A PROCEDURE;
     3.     _begin
     4.         _common /A/ X, Y;
     5.         _real Y, X;
     6.         _common /B/ U, V;
     7.         _real U;
     8.         _common /C/ F;
     9.         _integer _procedure F; F := 1;
    10.         X := 1;
    11.         print(X)
    12.     _end

