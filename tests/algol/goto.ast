externals: []
block:
  kind: block
  loc: 1/1
  decls:
    - {kind: var, line: 3, name: "I", id: 1, type: integer}
    - kind: procedure
      line: 4
      name: "P"
      id: 2
      type: none
      formals:
        - {name: "N", id: 3, spec: simple, type: integer, by_value: true}
      body:
        kind: compound
        loc: 5/1
        body:
          - kind: if
            loc: 6/1
            condition:
              kind: binary
              type: boolean
              op: gt
              left: {kind: var, type: integer, decl: 3, name: "N"}
              right: {kind: int_const, type: integer, value: 2}
            then:
              kind: goto
              loc: 6/2
              target: {kind: label_ref, type: none, label: 6, name: "OUT"}
          - kind: io
            loc: 7/1
            op: print
            params: []
            items:
              - kind: item
                expr: {kind: var, type: integer, decl: 3, name: "N"}
              - {kind: new_line}
    - {kind: label, line: 10, name: "AGAIN", id: 4}
    - {kind: label, line: 22, name: "L2", id: 5}
    - {kind: label, line: 24, name: "OUT", id: 6}
  body:
    - kind: assign
      loc: 9/1
      targets:
        - {kind: var, decl: 1, name: "I"}
      value: {kind: int_const, type: integer, value: 0}
    - kind: labeled
      loc: 10/1
      label: 4
      name: "AGAIN"
      stmt:
        kind: assign
        loc: 11/1
        targets:
          - {kind: var, decl: 1, name: "I"}
        value:
          kind: binary
          type: integer
          op: add
          left: {kind: var, type: integer, decl: 1, name: "I"}
          right: {kind: int_const, type: integer, value: 1}
    - kind: if
      loc: 12/1
      condition:
        kind: binary
        type: boolean
        op: lt
        left: {kind: var, type: integer, decl: 1, name: "I"}
        right: {kind: int_const, type: integer, value: 3}
      then:
        kind: goto
        loc: 12/2
        target: {kind: label_ref, type: none, label: 4, name: "AGAIN"}
    - kind: io
      loc: 13/1
      op: print
      params: []
      items:
        - kind: item
          expr: {kind: var, type: integer, decl: 1, name: "I"}
        - {kind: new_line}
    - kind: block
      loc: 14/1
      decls:
        - {kind: var, line: 14, name: "K", id: 7, type: integer}
        - {kind: label, line: 18, name: "L1", id: 8}
      body:
        - kind: assign
          loc: 15/1
          targets:
            - {kind: var, decl: 7, name: "K"}
          value: {kind: int_const, type: integer, value: 5}
        - kind: goto
          loc: 16/1
          target: {kind: label_ref, type: none, label: 8, name: "L1"}
        - kind: io
          loc: 17/1
          op: print
          params: []
          items:
            - kind: item
              expr:
                kind: unary
                type: integer
                op: neg
                operand: {kind: int_const, type: integer, value: 1}
            - {kind: new_line}
        - kind: labeled
          loc: 18/1
          label: 8
          name: "L1"
          stmt:
            kind: io
            loc: 18/2
            op: print
            params: []
            items:
              - kind: item
                expr: {kind: var, type: integer, decl: 7, name: "K"}
              - {kind: new_line}
        - kind: goto
          loc: 19/1
          target: {kind: label_ref, type: none, label: 5, name: "L2"}
    - kind: io
      loc: 21/1
      op: print
      params: []
      items:
        - kind: item
          expr:
            kind: unary
            type: integer
            op: neg
            operand: {kind: int_const, type: integer, value: 2}
        - {kind: new_line}
    - kind: labeled
      loc: 22/1
      label: 5
      name: "L2"
      stmt:
        kind: call
        loc: 22/2
        proc: 2
        name: "P"
        args:
          - {kind: int_const, type: integer, value: 1}
    - kind: call
      loc: 22/3
      proc: 2
      name: "P"
      args:
        - {kind: int_const, type: integer, value: 2}
    - kind: call
      loc: 22/4
      proc: 2
      name: "P"
      args:
        - {kind: int_const, type: integer, value: 3}
    - kind: io
      loc: 23/1
      op: print
      params: []
      items:
        - kind: item
          expr:
            kind: unary
            type: integer
            op: neg
            operand: {kind: int_const, type: integer, value: 3}
        - {kind: new_line}
    - kind: labeled
      loc: 24/1
      label: 6
      name: "OUT"
      stmt:
        kind: io
        loc: 25/1
        op: print
        params: []
        items:
          - kind: item
            expr: {kind: int_const, type: integer, value: 999}
          - {kind: new_line}
