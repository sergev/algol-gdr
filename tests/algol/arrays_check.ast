externals: []
block:
  kind: block
  loc: 1/2
  decls:
    - {kind: var, name: "I", id: 1, type: integer}
    - {kind: var, name: "J", id: 2, type: integer}
    - {kind: var, name: "N", id: 3, type: integer}
    - kind: arrays
      type: real
      arrays:
        - {name: "A", id: 4}
      bounds:
        - lower: {kind: int_const, type: integer, value: 1}
          upper: {kind: int_const, type: integer, value: 5}
    - kind: arrays
      type: integer
      arrays:
        - {name: "B", id: 5}
      bounds:
        - lower: {kind: int_const, type: integer, value: 0}
          upper: {kind: int_const, type: integer, value: 2}
        - lower:
            kind: unary
            type: integer
            op: neg
            operand: {kind: int_const, type: integer, value: 1}
          upper: {kind: int_const, type: integer, value: 1}
    - kind: arrays
      type: boolean
      arrays:
        - {name: "F", id: 6}
      bounds:
        - lower: {kind: int_const, type: integer, value: 1}
          upper: {kind: int_const, type: integer, value: 2}
  body:
    - kind: for
      loc: 8/1
      control: {kind: var, decl: 1, name: "I"}
      elements:
        - kind: step_until
          init: {kind: int_const, type: integer, value: 1}
          step: {kind: int_const, type: integer, value: 1}
          until: {kind: int_const, type: integer, value: 5}
      body:
        kind: assign
        loc: 8/2
        targets:
          - kind: element
            array: 4
            name: "A"
            subscripts:
              - {kind: var, type: integer, decl: 1, name: "I"}
        value:
          kind: binary
          type: real
          op: div
          left:
            kind: convert
            type: real
            conv: int_to_real
            expr: {kind: var, type: integer, decl: 1, name: "I"}
          right:
            kind: convert
            type: real
            conv: int_to_real
            expr: {kind: int_const, type: integer, value: 2}
    - kind: io
      loc: 9/1
      op: print
      params: []
      items:
        - kind: item
          expr:
            kind: element
            type: real
            array: 4
            name: "A"
            subscripts:
              - {kind: int_const, type: integer, value: 1}
        - kind: item
          expr:
            kind: element
            type: real
            array: 4
            name: "A"
            subscripts:
              - {kind: int_const, type: integer, value: 5}
    - kind: for
      loc: 10/1
      control: {kind: var, decl: 1, name: "I"}
      elements:
        - kind: step_until
          init: {kind: int_const, type: integer, value: 0}
          step: {kind: int_const, type: integer, value: 1}
          until: {kind: int_const, type: integer, value: 2}
      body:
        kind: for
        loc: 11/1
        control: {kind: var, decl: 2, name: "J"}
        elements:
          - kind: step_until
            init:
              kind: unary
              type: integer
              op: neg
              operand: {kind: int_const, type: integer, value: 1}
            step: {kind: int_const, type: integer, value: 1}
            until: {kind: int_const, type: integer, value: 1}
        body:
          kind: assign
          loc: 12/1
          targets:
            - kind: element
              array: 5
              name: "B"
              subscripts:
                - {kind: var, type: integer, decl: 1, name: "I"}
                - {kind: var, type: integer, decl: 2, name: "J"}
          value:
            kind: binary
            type: integer
            op: add
            left:
              kind: binary
              type: integer
              op: mul
              left: {kind: int_const, type: integer, value: 10}
              right: {kind: var, type: integer, decl: 1, name: "I"}
            right: {kind: var, type: integer, decl: 2, name: "J"}
    - kind: io
      loc: 13/1
      op: print
      params: []
      items:
        - kind: item
          expr:
            kind: element
            type: integer
            array: 5
            name: "B"
            subscripts:
              - {kind: int_const, type: integer, value: 0}
              - kind: unary
                type: integer
                op: neg
                operand: {kind: int_const, type: integer, value: 1}
        - kind: item
          expr:
            kind: element
            type: integer
            array: 5
            name: "B"
            subscripts:
              - {kind: int_const, type: integer, value: 2}
              - {kind: int_const, type: integer, value: 1}
        - kind: item
          expr:
            kind: element
            type: integer
            array: 5
            name: "B"
            subscripts:
              - {kind: int_const, type: integer, value: 1}
              - {kind: int_const, type: integer, value: 0}
    - kind: assign
      loc: 14/1
      targets:
        - kind: element
          array: 6
          name: "F"
          subscripts:
            - {kind: int_const, type: integer, value: 1}
      value: {kind: bool_const, type: boolean, value: true}
    - kind: assign
      loc: 14/2
      targets:
        - kind: element
          array: 6
          name: "F"
          subscripts:
            - {kind: int_const, type: integer, value: 2}
      value:
        kind: unary
        type: boolean
        op: not
        operand:
          kind: element
          type: boolean
          array: 6
          name: "F"
          subscripts:
            - {kind: int_const, type: integer, value: 1}
    - kind: io
      loc: 15/1
      op: print
      params: []
      items:
        - kind: item
          expr:
            kind: element
            type: boolean
            array: 6
            name: "F"
            subscripts:
              - {kind: int_const, type: integer, value: 1}
        - kind: item
          expr:
            kind: element
            type: boolean
            array: 6
            name: "F"
            subscripts:
              - {kind: int_const, type: integer, value: 2}
    - kind: assign
      loc: 16/1
      targets:
        - {kind: var, decl: 3, name: "N"}
      value: {kind: int_const, type: integer, value: 4}
    - kind: block
      loc: 17/2
      decls:
        - kind: arrays
          type: real
          arrays:
            - {name: "C", id: 7}
          bounds:
            - lower: {kind: int_const, type: integer, value: 1}
              upper: {kind: var, type: integer, decl: 3, name: "N"}
            - lower: {kind: int_const, type: integer, value: 1}
              upper:
                kind: binary
                type: integer
                op: add
                left: {kind: var, type: integer, decl: 3, name: "N"}
                right: {kind: int_const, type: integer, value: 1}
        - kind: arrays
          type: integer
          arrays:
            - {name: "D", id: 8}
          bounds:
            - lower: {kind: var, type: integer, decl: 3, name: "N"}
              upper:
                kind: binary
                type: integer
                op: mul
                left: {kind: int_const, type: integer, value: 2}
                right: {kind: var, type: integer, decl: 3, name: "N"}
      body:
        - kind: for
          loc: 20/1
          control: {kind: var, decl: 1, name: "I"}
          elements:
            - kind: step_until
              init: {kind: int_const, type: integer, value: 1}
              step: {kind: int_const, type: integer, value: 1}
              until: {kind: var, type: integer, decl: 3, name: "N"}
          body:
            kind: for
            loc: 21/1
            control: {kind: var, decl: 2, name: "J"}
            elements:
              - kind: step_until
                init: {kind: int_const, type: integer, value: 1}
                step: {kind: int_const, type: integer, value: 1}
                until:
                  kind: binary
                  type: integer
                  op: add
                  left: {kind: var, type: integer, decl: 3, name: "N"}
                  right: {kind: int_const, type: integer, value: 1}
            body:
              kind: assign
              loc: 22/1
              targets:
                - kind: element
                  array: 7
                  name: "C"
                  subscripts:
                    - {kind: var, type: integer, decl: 1, name: "I"}
                    - {kind: var, type: integer, decl: 2, name: "J"}
              value:
                kind: convert
                type: real
                conv: int_to_real
                expr:
                  kind: binary
                  type: integer
                  op: mul
                  left: {kind: var, type: integer, decl: 1, name: "I"}
                  right: {kind: var, type: integer, decl: 2, name: "J"}
        - kind: assign
          loc: 23/1
          targets:
            - kind: element
              array: 8
              name: "D"
              subscripts:
                - kind: binary
                  type: integer
                  op: mul
                  left: {kind: int_const, type: integer, value: 2}
                  right: {kind: var, type: integer, decl: 3, name: "N"}
          value: {kind: var, type: integer, decl: 3, name: "N"}
        - kind: io
          loc: 24/1
          op: print
          params: []
          items:
            - kind: item
              expr:
                kind: element
                type: real
                array: 7
                name: "C"
                subscripts:
                  - {kind: var, type: integer, decl: 3, name: "N"}
                  - kind: binary
                    type: integer
                    op: add
                    left: {kind: var, type: integer, decl: 3, name: "N"}
                    right: {kind: int_const, type: integer, value: 1}
            - kind: item
              expr:
                kind: element
                type: integer
                array: 8
                name: "D"
                subscripts:
                  - {kind: int_const, type: integer, value: 8}
