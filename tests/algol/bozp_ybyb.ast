externals:
  - {kind: code, name: "rndm", id: 1, type: real}
  - {kind: algol, name: "BOZP", id: 2}
  - {kind: algol, name: "YBYB", id: 3}
block:
  kind: block
  loc: 4/1
  decls:
    - kind: arrays
      line: 5
      type: real
      arrays:
        - {name: "a", id: 4}
      bounds:
        - lower: {kind: int_const, type: integer, value: 1}
          upper: {kind: int_const, type: integer, value: 10}
    - {kind: var, line: 6, name: "i", id: 5, type: integer}
  body:
    - kind: for
      loc: 8/1
      control: {kind: var, decl: 5, name: "i"}
      elements:
        - kind: step_until
          init: {kind: int_const, type: integer, value: 1}
          step: {kind: int_const, type: integer, value: 1}
          until: {kind: int_const, type: integer, value: 10}
      body:
        kind: assign
        loc: 9/1
        targets:
          - kind: element
            array: 4
            name: "a"
            subscripts:
              - {kind: var, type: integer, decl: 5, name: "i"}
        value:
          kind: call
          type: real
          proc: 1
          name: "rndm"
          args:
            - kind: unary
              type: integer
              op: neg
              operand: {kind: int_const, type: integer, value: 1}
    - kind: io
      loc: 11/1
      op: write
      params:
        - {kind: string_const, type: string, value: "(10f7.3)"}
      items:
        - kind: item
          expr: {kind: var, type: real, decl: 4, name: "a"}
    - kind: call
      loc: 14/1
      proc: 2
      name: "BOZP"
      args:
        - {kind: var, type: real, decl: 4, name: "a"}
        - {kind: int_const, type: integer, value: 10}
    - kind: io
      loc: 15/1
      op: write
      params:
        - {kind: string_const, type: string, value: "(10f7.3)"}
      items:
        - kind: item
          expr: {kind: var, type: real, decl: 4, name: "a"}
    - kind: call
      loc: 18/1
      proc: 3
      name: "YBYB"
      args:
        - {kind: var, type: real, decl: 4, name: "a"}
        - {kind: int_const, type: integer, value: 10}
    - kind: io
      loc: 19/1
      op: write
      params:
        - {kind: string_const, type: string, value: "(10f7.3)"}
      items:
        - kind: item
          expr: {kind: var, type: real, decl: 4, name: "a"}
