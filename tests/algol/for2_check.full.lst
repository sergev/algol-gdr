*NAME FOR2_CHECK
*CHECK
*CALL SETFTN:ONE,LONG
*PUNCH
*FULL
*ALGOL
                                             04 ИЮЛ 24 23.45
A L G O L - Г Д P
    (7.01.82)

     1.     ′COMMENT′ FOR LOOPS REWRITTEN BY PASS 3, AND LOOPS IT GIVES UP ON;
     2.     ′BEGIN′ ′INTEGER′ I, J, K; ′BOOLEAN′ B;
     3.       ′INTEGER′ ′ARRAY′ IA[-10:20];
     4.       ′PROCEDURE′ SHOW;
     5.       ′BEGIN′ ′FOR′ K := -10 ′STEP′ 1 ′UNTIL′ 20 ′DO′ PRINT(IA[K]);
     6.         ′FOR′ K := -10 ′STEP′ 1 ′UNTIL′ 20 ′DO′ IA[K] := 0
     7.       ′END′;
     8.       J := 1; B := ′TRUE′;
     9.       ′FOR′ K := -10 ′STEP′ 1 ′UNTIL′ 20 ′DO′ IA[K] := 0;
    10.       ′FOR′ I := 1 ′STEP′ 1 ′UNTIL′ 3 ′DO′ IA[I] := I;
    11.       ′FOR′ I := 1 ′STEP′ 1 ′UNTIL′ 3 ′DO′ IA[I+1] := IA[I]; SHOW;
    12.       ′FOR′ I := 1 ′STEP′ 1 ′UNTIL′ 3 ′DO′ IA[2*I-1] := I;
    13.       ′FOR′ I := 1 ′STEP′ 1 ′UNTIL′ 3 ′DO′ IA[-I+5] := I+10;
    14.       ′FOR′ I := 1 ′STEP′ 1 ′UNTIL′ 3 ′DO′ IA[I-J] := I+20; SHOW;
    15.       ′FOR′ I := 1 ′STEP′ 1 ′UNTIL′ 3 ′DO′ ′IF′ B ′THEN′ IA[I] := I;
    16.       ′FOR′ I := 1 ′STEP′ 1 ′UNTIL′ 3 ′DO′ IA[3-I] := I+10;
    17.       ′FOR′ I := 1 ′STEP′ 1 ′UNTIL′ 3 ′DO′ IA[1] := I; SHOW;
    18.       ′FOR′ I := 1 ′STEP′ 1 ′UNTIL′ 3 ′DO′ ′IF′ B ′THEN′ ′GOTO′ L1;
    19.     L1: PRINT(I);
    20.       ′FOR′ I := 1 ′STEP′ 1 ′UNTIL′ 3 ′DO′ ′GOTO′ L2;
    21.     L2: PRINT(I);
    22.       ′FOR′ I := 1 ′STEP′ 1 ′UNTIL′ 3 ′DO′ I := I; PRINT(I);
    23.       ′FOR′ I := 1 ′STEP′ 1 ′UNTIL′ 3 ′DO′
    24.       ′BEGIN′ L3: IA[I] := IA[I] + 1;
    25.         ′IF′ IA[I] ′LT′ 3 ′THEN′ ′GOTO′ L3
    26.       ′END′;
    27.       ′FOR′ I := 1 ′STEP′ 1 ′UNTIL′ 3 ′DO′
    28.         ′IF′ J ′LT′ 2 ′THEN′ IA[I+3] := I;
    29.       SHOW;
    30.       ′FOR′ I := 3 ′STEP′ -1 ′UNTIL′ 1 ′DO′ IA[I] := I;
    31.       ′FOR′ I := 3 ′STEP′ -1 ′UNTIL′ 1 ′DO′ IA[(I+1)+(I+2)] := I; SHOW;
    32.       ′FOR′ I := 1 ′STEP′ J ′UNTIL′ 3 ′DO′ IA[I+1] := IA[I]+1;
    33.       ′FOR′ I := 1 ′STEP′ J ′UNTIL′ 3 ′DO′ ′IF′ B ′THEN′ IA[I+5] := I; SHOW;
    34.       ′FOR′ I := 1 ′STEP′ 1 ′UNTIL′ 3 ′DO′ IA[(I+1)-(I+2)] := I;
    35.       ′FOR′ I := 1 ′STEP′ 1 ′UNTIL′ 3 ′DO′ IA[(I-1)*(2+1)] := I+10;
    36.       ′FOR′ I := 1 ′STEP′ 1 ′UNTIL′ 3 ′DO′ IA[1+2] := I+20; SHOW;
    37.       ′FOR′ I := 1 ′STEP′ 1 ′UNTIL′ 3 ′DO′ IA[I+(2-1)] := I;
    38.       ′FOR′ I := 1 ′STEP′ 1 ′UNTIL′ 3 ′DO′ IA[I+2*3] := I+10;
    39.       ′FOR′ I := 1 ′STEP′ 1 ′UNTIL′ 3 ′DO′ IA[I*(-2)] := I+20;
    40.       ′FOR′ I := 1 ′STEP′ 1 ′UNTIL′ 3 ′DO′ IA[2-I+5] := I+30; SHOW
    41.     ′END′
    42.     ′EOP′

