A L G O L - Г Д P
    (7.01.82)

     1.     'BEGIN'
     2.         'COMMENT' TYPE ERRORS;
     3.         'INTEGER' I;
     4.         'REAL' X;
     5.         'BOOLEAN' B;
     6.         I := 'TRUE';
     7.         B := 1;
     8.         X := B + 1;
     9.         'IF' X 'THEN' I := 0;
    10.         B := I 'AND' B;
    11.     'END'
    12.     'EOP'

