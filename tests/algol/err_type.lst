    (7.01.82)

     1.     _begin
     2.         _comment TYPE ERRORS;
     3.         _integer I;
     4.         _real X;
     5.         _boolean B;
     6.         I := _true;
     7.         B := 1;
     8.         X := B + 1;
     9.         _if X _then I := 0;
    10.         B := I _and B;
    11.     _end

