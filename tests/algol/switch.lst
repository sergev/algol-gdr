*NAME SWITCH
*PUNCH
*ALGOL                                             04 ИЮЛ 24 23.45
A L G O L - Г Д P
    (7.01.82)
           1. ′BEGIN′
           2.     ′COMMENT′ SWITCH DECLARATIONS AND DESIGNAT
               IONAL EXPRESSIONS;
           3.     ′INTEGER′ I;
           4.     ′SWITCH′ S := A, B, ′IF′ I > 2 ′THEN′ C ′E
               LSE′ A;
           5.     I := 0;
           6. NEXT:
           7.     I := I + 1;
           8.     ′IF′ I > 3 ′THEN′ ′GOTO′ DONE;
           9.     ′GOTO′ S[I];
          10. A:  PRINT(1); ′GOTO′ NEXT;
          11. B:  PRINT(2); ′GOTO′ NEXT;
          12. C:  PRINT(3); ′GOTO′ NEXT;
          13. DONE:
          14.     ′GOTO′ ′IF′ I = 4 ′THEN′ E ′ELSE′ S[1];
          15. E:  PRINT(I)
          16. ′END′
          17. ′EOP′
