A L G O L - Г Д P
    (7.01.82)

     1.     _begin
     2.         _comment PROCEDURES: VALUE AND NAME PARAMETERS, RECURSION,
     3.             FUNCTIONS, PROCEDURES AS PARAMETERS, JENSEN'S DEVICE;
     4.         _integer I, K;
     5.         _real _array V[1:3];
     6.         _integer _procedure FACT(N); _value N; _integer N;
     7.             FACT := _if N _le 1 _then 1 _else N * FACT(N - 1);
     8.         _procedure INC(X); _integer X;
     9.             X := X + 1;
    10.         _procedure INCV(X); _value X; _integer X;
    11.             X := X + 1;
    12.         _real _procedure SUM(J, L, U, T); _value L, U;
    13.             _integer J, L, U; _real T;
    14.         _begin _real S; S := 0;
    15.             _for J := L _step 1 _until U _do S := S + T;
    16.             SUM := S
    17.         _end;
    18.         _real _procedure SQ(X); _value X; _real X;
    19.             SQ := X * X;
    20.         _real _procedure APPLY(F, X); _real _procedure F; _real X;
    21.             APPLY := F(X);
    22.         _procedure NOARGS;
    23.             print(77, NEWLINE);
    24.         K := 1;
    25.         INC(K); INCV(K);
    26.         print(K, FACT(10), NEWLINE);
    27.         V[1] := 1; V[2] := 2; V[3] := 3;
    28.         print(SUM(I, 1, 3, V[I] * V[I]), NEWLINE);
    29.         print(APPLY(SQ, 3.0), NEWLINE);
    30.         NOARGS
    31.     _end

