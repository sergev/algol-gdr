externals: []
block:
  kind: block
  loc: 1/2
  decls:
    - kind: common
      name: "ABC"
      elements:
        - {name: "X", decl: 2, size: 1}
        - {name: "Y", decl: 3, size: 10}
        - {name: "Z", decl: 4, size: 6}
    - kind: common
      name: "DATA"
      elements:
        - {name: "N", decl: 6, size: 1}
        - {name: "T", decl: 7, size: 8}
    - kind: common
      name: "S"
      elements:
        - {name: "W", decl: 9, size: 1}
    - kind: arrays
      type: real
      arrays:
        - {name: "X", id: 2}
      bounds:
        - lower: {kind: int_const, type: integer, value: 1}
          upper: {kind: int_const, type: integer, value: 1}
    - kind: arrays
      type: real
      arrays:
        - {name: "Y", id: 3}
      bounds:
        - lower: {kind: int_const, type: integer, value: 1}
          upper: {kind: int_const, type: integer, value: 10}
    - kind: arrays
      type: integer
      arrays:
        - {name: "Z", id: 4}
      bounds:
        - lower: {kind: int_const, type: integer, value: 1}
          upper: {kind: int_const, type: integer, value: 2}
        - lower: {kind: int_const, type: integer, value: 1}
          upper: {kind: int_const, type: integer, value: 3}
    - kind: arrays
      type: integer
      arrays:
        - {name: "N", id: 6}
      bounds:
        - lower: {kind: int_const, type: integer, value: 1}
          upper: {kind: int_const, type: integer, value: 1}
    - kind: arrays
      type: real
      arrays:
        - {name: "T", id: 7}
      bounds:
        - lower: {kind: int_const, type: integer, value: 1}
          upper: {kind: int_const, type: integer, value: 2}
        - lower: {kind: int_const, type: integer, value: 1}
          upper: {kind: int_const, type: integer, value: 2}
        - lower: {kind: int_const, type: integer, value: 1}
          upper: {kind: int_const, type: integer, value: 2}
    - kind: arrays
      type: boolean
      arrays:
        - {name: "W", id: 9}
      bounds:
        - lower: {kind: int_const, type: integer, value: 1}
          upper: {kind: int_const, type: integer, value: 1}
  body:
    - kind: assign
      loc: 10/1
      targets:
        - kind: element
          array: 2
          name: "X"
          subscripts:
            - {kind: int_const, type: integer, value: 1}
      value:
        kind: convert
        type: real
        conv: int_to_real
        expr: {kind: int_const, type: integer, value: 1}
    - kind: assign
      loc: 10/2
      targets:
        - kind: element
          array: 3
          name: "Y"
          subscripts:
            - {kind: int_const, type: integer, value: 1}
      value:
        kind: convert
        type: real
        conv: int_to_real
        expr: {kind: int_const, type: integer, value: 2}
    - kind: assign
      loc: 10/3
      targets:
        - kind: element
          array: 4
          name: "Z"
          subscripts:
            - {kind: int_const, type: integer, value: 2}
            - {kind: int_const, type: integer, value: 3}
      value: {kind: int_const, type: integer, value: 3}
    - kind: assign
      loc: 11/1
      targets:
        - kind: element
          array: 6
          name: "N"
          subscripts:
            - {kind: int_const, type: integer, value: 1}
      value: {kind: int_const, type: integer, value: 4}
    - kind: assign
      loc: 11/2
      targets:
        - kind: element
          array: 7
          name: "T"
          subscripts:
            - {kind: int_const, type: integer, value: 2}
            - {kind: int_const, type: integer, value: 2}
            - {kind: int_const, type: integer, value: 2}
      value:
        kind: convert
        type: real
        conv: int_to_real
        expr: {kind: int_const, type: integer, value: 5}
    - kind: assign
      loc: 11/3
      targets:
        - kind: element
          array: 9
          name: "W"
          subscripts:
            - {kind: int_const, type: integer, value: 1}
      value: {kind: bool_const, type: boolean, value: true}
    - kind: io
      loc: 12/1
      op: print
      params: []
      items:
        - kind: item
          expr:
            kind: element
            type: real
            array: 2
            name: "X"
            subscripts:
              - {kind: int_const, type: integer, value: 1}
        - kind: item
          expr:
            kind: element
            type: real
            array: 3
            name: "Y"
            subscripts:
              - {kind: int_const, type: integer, value: 1}
        - kind: item
          expr:
            kind: element
            type: integer
            array: 4
            name: "Z"
            subscripts:
              - {kind: int_const, type: integer, value: 2}
              - {kind: int_const, type: integer, value: 3}
        - kind: item
          expr:
            kind: element
            type: integer
            array: 6
            name: "N"
            subscripts:
              - {kind: int_const, type: integer, value: 1}
        - kind: item
          expr:
            kind: element
            type: real
            array: 7
            name: "T"
            subscripts:
              - {kind: int_const, type: integer, value: 2}
              - {kind: int_const, type: integer, value: 2}
              - {kind: int_const, type: integer, value: 2}
        - kind: item
          expr:
            kind: element
            type: boolean
            array: 9
            name: "W"
            subscripts:
              - {kind: int_const, type: integer, value: 1}
