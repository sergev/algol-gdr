A L G O L - Г Д P
    (7.01.82)

     1.     _comment FOR LIST ELEMENTS, CONDITIONAL AND POWER EXPRESSIONS;
     2.     _begin _integer I; _real X; _boolean B;
     3.       _integer _array IA[1:3]; _real _array RA[1:3];
     4.       _boolean _array BA[1:3];
     5.       _switch S := L, M;
     6.       _integer _procedure IP(N); _value N; _integer N; IP := N;
     7.       _real _procedure RP; RP := 1;
     8.       _boolean _procedure BP; BP := _true;
     9.       _procedure P0; ;
    10.       _procedure PP(A1, A2, A3, A4, A5, A6, A7, A8);
    11.         _value A1; _integer A1; _real A2; _boolean A3; _array A4;
    12.         _label A5; _procedure A6; _string A7; _switch A8;
    13.       _begin A2 := A1 _end;
    14.     L: I := 1;
    15.     M: X := 1;
    16.       I := 1; X := 2; B := _true;
    17.       IA[1] := 1; IA[2] := 2; IA[3] := 3;
    18.       I := IA[X]; PRINT(I);
    19.       I := _if B _then I _else X; PRINT(I);
    20.       B := X _lt 1; PRINT(B);
    21.       B := X _equal 1; PRINT(B);
    22.       X := 2 _power I; PRINT(X);
    23.       X := 2 _power IP(1); PRINT(X);
    24.       PRINT(IA);
    25.       _for I := I _step 1 _until 2 _do X := 1; PRINT(I);
    26.       _for I := X _step 1 _until 2 _do X := 1; PRINT(I);
    27.       _for I := IA[1] _step 1 _until 2 _do X := 1; PRINT(I);
    28.       _for I := RP _step 1 _until 2 _do X := 1; PRINT(I);
    29.       _for I := 1.5 _step 1 _until 2 _do X := 1; PRINT(I);
    30.       _for I := -I _step 1 _until 2 _do X := 1; PRINT(I)
    31.     _end

