A L G O L - Г Д P
    (7.01.82)

     1.     _begin
     2.         _comment PROCEDURES, REALS, RECURSION, NAME AND VALUE PARAMETERS;
     3.         _real _procedure F(X); _value X; _real X;
     4.             F := _if X < 1.0 _then 1.0 _else X * F(X - 1.0);
     5.         _integer _procedure SUM(I, A, B, T); _value A, B;
     6.             _integer I, A, B, T;
     7.         _begin _integer S; S := 0;
     8.             _for I := A _step 1 _until B _do S := S + T;
     9.             SUM := S
    10.         _end;
    11.         _procedure SWAP(P, Q); _real P, Q;
    12.         _begin _real T; T := P; P := Q; Q := T _end;
    13.         _integer J; _real U, V;
    14.         _integer _array C[1:3];
    15.         U := 1.5; V := -0.00225;
    16.         SWAP(U, V);
    17.         PRINT(U, V, F(5.0), SUM(J, 1, 10, J*J));
    18.         PRINT(SQRT(2.0), SIN(1.0), COS(1.0));
    19.         PRINT(ARCTAN(1.0), LN(10.0), EXP(1.0));
    20.         PRINT(ABS(-3), SIGN(-2.0), ENTIER(3.7));
    21.         C[2] := ENTIER(7 / 2); PRINT(C[2], 7 / 2)
    22.     _end

