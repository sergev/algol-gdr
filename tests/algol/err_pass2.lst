A L G O L - Г Д P
    (7.01.82)

     1.     _comment TYPE AND USE ERRORS FOUND BY PASS 2;
     2.     _code: CP;
     3.     _algol: AP;
     4.     _begin _integer I; _real X; _boolean B;
     5.       _integer _array IA[1:3]; _real _array RA[1:3];
     6.       _boolean _array BA[1:3];
     7.       _switch S := L, M;
     8.       _integer _procedure IP(N); _value N; _integer N; IP := N;
     9.       _real _procedure RP; RP := 1;
    10.       _boolean _procedure BP; BP := _true;
    11.       _procedure P0; ;
    12.       _procedure PP(A1, A2, A3, A4, A5, A6, A7, A8);
    13.         _value A1; _integer A1; _real A2; _boolean A3; _array A4;
    14.         _label A5; _procedure A6; _string A7; _switch A8;
    15.       _begin A2 := A1 _end;
    16.     L: I := 1;
    17.     M: X := 1;
    18.       I := PP;
    19.       I := IA;
    20.       I := AP;
    21.       I := I _lt X;
    22.       I := IP(X);
    23.       I := IP(B);
    24.       I := IA[B];
    25.       I := IA[1,2];
    26.       I := `S'+`T';
    27.       IP(1) := 1;
    28.       IA := 1;
    29.       length := 1;
    30.       I := X := I;
    31.       _for I := B _step 1 _until 2 _do X := 1;
    32.       _for B := 1 _step 1 _until 2 _do X := 1;
    33.       _goto I;
    34.       IA[P0] := 1;
    35.       I := _not B + 1;
    36.       I := _if B _then B _else B + 1;
    37.       B := B _lt 1;
    38.       B := 1 _lt B;
    39.       B := 1 _lt P0;
    40.       X := B _power 2;
    41.       PRINT(P0);
    42.       PRINT(PP);
    43.       PUNCH(S);
    44.       I := length(I);
    45.       CP(P0);
    46.       CP(PP);
    47.       X := sin(B);
    48.       X := -B;
    49.       STOP(I);
    50.       ASSIGN(I);
    51.       PP(1, I, B, RA, L, P0, `S', S);
    52.       PP(1, X, B, RA, CP, P0, `S', S)
    53.     _end

