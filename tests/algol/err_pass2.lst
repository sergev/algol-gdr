A L G O L - Г Д P
    (7.01.82)

     1.     ′COMMENT′ TYPE AND USE ERRORS FOUND BY PASS 2;
     2.     ′CODE′: CP;
     3.     ′ALGOL′: AP;
     4.     ′BEGIN′ ′INTEGER′ I; ′REAL′ X; ′BOOLEAN′ B;
     5.       ′INTEGER′ ′ARRAY′ IA[1:3]; ′REAL′ ′ARRAY′ RA[1:3];
     6.       ′BOOLEAN′ ′ARRAY′ BA[1:3];
     7.       ′SWITCH′ S := L, M;
     8.       ′INTEGER′ ′PROCEDURE′ IP(N); ′VALUE′ N; ′INTEGER′ N; IP := N;
     9.       ′REAL′ ′PROCEDURE′ RP; RP := 1;
    10.       ′BOOLEAN′ ′PROCEDURE′ BP; BP := ′TRUE′;
    11.       ′PROCEDURE′ P0; ;
    12.       ′PROCEDURE′ PP(A1, A2, A3, A4, A5, A6, A7, A8);
    13.         ′VALUE′ A1; ′INTEGER′ A1; ′REAL′ A2; ′BOOLEAN′ A3; ′ARRAY′ A4;
    14.         ′LABEL′ A5; ′PROCEDURE′ A6; ′STRING′ A7; ′SWITCH′ A8;
    15.       ′BEGIN′ A2 := A1 ′END′;
    16.     L: I := 1;
    17.     M: X := 1;
    18.       I := PP;
    19.       I := IA;
    20.       I := AP;
    21.       I := I ′LT′ X;
    22.       I := IP(X);
    23.       I := IP(B);
    24.       I := IA[B];
    25.       I := IA[1,2];
    26.       I := ′′S′′+′′T′′;
    27.       IP(1) := 1;
    28.       IA := 1;
    29.       LENGTH := 1;
    30.       I := X := I;
    31.       ′FOR′ I := B ′STEP′ 1 ′UNTIL′ 2 ′DO′ X := 1;
    32.       ′FOR′ B := 1 ′STEP′ 1 ′UNTIL′ 2 ′DO′ X := 1;
    33.       ′GOTO′ I;
    34.       IA[P0] := 1;
    35.       I := ′NOT′ B + 1;
    36.       I := ′IF′ B ′THEN′ B ′ELSE′ B + 1;
    37.       B := B ′LT′ 1;
    38.       B := 1 ′LT′ B;
    39.       B := 1 ′LT′ P0;
    40.       X := B ′POWER′ 2;
    41.       PRINT(P0);
    42.       PRINT(PP);
    43.       PUNCH(S);
    44.       I := LENGTH(I);
    45.       CP(P0);
    46.       CP(PP);
    47.       X := SIN(B);
    48.       X := -B;
    49.       STOP(I);
    50.       ASSIGN(I);
    51.       PP(1, I, B, RA, L, P0, ′′S′′, S);
    52.       PP(1, X, B, RA, CP, P0, ′′S′′, S)
    53.     ′END′
    54.     ′EOP′

