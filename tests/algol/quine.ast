externals: []
block:
  kind: block
  loc: 1/2
  decls:
    - {kind: var, name: "I", id: 2, type: integer}
    - {kind: var, name: "J", id: 3, type: integer}
    - {kind: var, name: "Q", id: 4, type: string}
    - {kind: var, name: "R", id: 5, type: string}
    - {kind: var, name: "S", id: 6, type: string}
    - kind: arrays
      type: string
      arrays:
        - {name: "L", id: 1}
      bounds:
        - lower: {kind: int_const, type: integer, value: 1}
          upper: {kind: int_const, type: integer, value: 7}
    - kind: procedure
      name: "P"
      id: 7
      type: none
      formals:
        - {name: "S", id: 8, spec: simple, type: string, by_value: false}
      body:
        kind: compound
        loc: 2/3
        body:
          - kind: for
            loc: 2/3
            control: {kind: var, decl: 3, name: "J"}
            elements:
              - kind: step_until
                init: {kind: int_const, type: integer, value: 1}
                step: {kind: int_const, type: integer, value: 1}
                until:
                  kind: std_func
                  type: integer
                  func: length
                  args:
                    - {kind: var, type: string, decl: 8, name: "S"}
            body:
              kind: io
              loc: 3/1
              op: print
              params: []
              items:
                - kind: item
                  expr:
                    kind: cond
                    type: string
                    condition:
                      kind: binary
                      type: boolean
                      op: and
                      left:
                        kind: binary
                        type: boolean
                        op: ne
                        left: {kind: var, type: integer, decl: 3, name: "J"}
                        right: {kind: int_const, type: integer, value: 45}
                      right:
                        kind: binary
                        type: boolean
                        op: eq
                        left:
                          kind: string_element
                          type: string
                          string: {kind: var, type: integer, decl: 3, name: "J"}
                          index: {kind: var, type: string, decl: 8, name: "S"}
                        right: {kind: string_const, type: string, value: "/"}
                    then: {kind: var, type: string, decl: 4, name: "Q"}
                    else:
                      kind: string_element
                      type: string
                      string: {kind: var, type: integer, decl: 3, name: "J"}
                      index: {kind: var, type: string, decl: 8, name: "S"}
          - kind: io
            loc: 4/2
            op: print
            params: []
            items:
              - {kind: new_line}
  body:
    - kind: assign
      loc: 4/4
      targets:
        - {kind: var, decl: 5, name: "R"}
      value: {kind: string_const, type: string, value: "1234567"}
    - kind: assign
      loc: 5/1
      targets:
        - kind: element
          array: 1
          name: "L"
          subscripts:
            - {kind: int_const, type: integer, value: 1}
      value: {kind: string_const, type: string, value: "/BEGIN//STRING//ARRAY/L[1:7];/INTEGER/I,J;/STRING/Q,R,S;"}
    - kind: assign
      loc: 6/1
      targets:
        - kind: element
          array: 1
          name: "L"
          subscripts:
            - {kind: int_const, type: integer, value: 2}
      value: {kind: string_const, type: string, value: "/PROCEDURE/P(S);/STRING/S;/BEGIN//FOR/J:=1/STEP/1/UNTIL/"}
    - kind: assign
      loc: 7/1
      targets:
        - kind: element
          array: 1
          name: "L"
          subscripts:
            - {kind: int_const, type: integer, value: 3}
      value: {kind: string_const, type: string, value: "LENGTH(S)/DO/PRINT(/IF/J/NE/45/AND/S[J] = ///// /THEN/ Q"}
    - kind: assign
      loc: 8/1
      targets:
        - kind: element
          array: 1
          name: "L"
          subscripts:
            - {kind: int_const, type: integer, value: 4}
      value: {kind: string_const, type: string, value: "/ELSE/ S[J]); PRINT(NEWLINE) /END/; R := //1234567//;"}
    - kind: assign
      loc: 9/1
      targets:
        - kind: element
          array: 1
          name: "L"
          subscripts:
            - {kind: int_const, type: integer, value: 5}
      value: {kind: string_const, type: string, value: "Q:=///47///;/FOR/ I:=1,2,3,4/DO/P(L[I]); /FOR/I:=1,2,3,4,"}
    - kind: assign
      loc: 10/1
      targets:
        - kind: element
          array: 1
          name: "L"
          subscripts:
            - {kind: int_const, type: integer, value: 6}
      value: {kind: string_const, type: string, value: "5,6,7/DO/PRINT(//L[//,R[I],//]:=//,Q,Q,L[I],Q,Q,//;//,"}
    - kind: assign
      loc: 11/1
      targets:
        - kind: element
          array: 1
          name: "L"
          subscripts:
            - {kind: int_const, type: integer, value: 7}
      value: {kind: string_const, type: string, value: "NEWLINE);/FOR/ I:=5,6,7 /DO/ P(L[I]); /END//EOP/"}
    - kind: assign
      loc: 12/1
      targets:
        - {kind: var, decl: 4, name: "Q"}
      value: {kind: string_const, type: string, value: "′"}
    - kind: for
      loc: 12/2
      control: {kind: var, decl: 2, name: "I"}
      elements:
        - kind: value
          value: {kind: int_const, type: integer, value: 1}
        - kind: value
          value: {kind: int_const, type: integer, value: 2}
        - kind: value
          value: {kind: int_const, type: integer, value: 3}
        - kind: value
          value: {kind: int_const, type: integer, value: 4}
      body:
        kind: call
        loc: 12/3
        proc: 7
        name: "P"
        args:
          - kind: element
            type: string
            array: 1
            name: "L"
            subscripts:
              - {kind: var, type: integer, decl: 2, name: "I"}
    - kind: for
      loc: 12/5
      control: {kind: var, decl: 2, name: "I"}
      elements:
        - kind: value
          value: {kind: int_const, type: integer, value: 1}
        - kind: value
          value: {kind: int_const, type: integer, value: 2}
        - kind: value
          value: {kind: int_const, type: integer, value: 3}
        - kind: value
          value: {kind: int_const, type: integer, value: 4}
        - kind: value
          value: {kind: int_const, type: integer, value: 5}
        - kind: value
          value: {kind: int_const, type: integer, value: 6}
        - kind: value
          value: {kind: int_const, type: integer, value: 7}
      body:
        kind: io
        loc: 13/1
        op: print
        params: []
        items:
          - kind: item
            expr: {kind: string_const, type: string, value: "L["}
          - kind: item
            expr:
              kind: string_element
              type: string
              string: {kind: var, type: integer, decl: 2, name: "I"}
              index: {kind: var, type: string, decl: 5, name: "R"}
          - kind: item
            expr: {kind: string_const, type: string, value: "]:="}
          - kind: item
            expr: {kind: var, type: string, decl: 4, name: "Q"}
          - kind: item
            expr: {kind: var, type: string, decl: 4, name: "Q"}
          - kind: item
            expr:
              kind: element
              type: string
              array: 1
              name: "L"
              subscripts:
                - {kind: var, type: integer, decl: 2, name: "I"}
          - kind: item
            expr: {kind: var, type: string, decl: 4, name: "Q"}
          - kind: item
            expr: {kind: var, type: string, decl: 4, name: "Q"}
          - kind: item
            expr: {kind: string_const, type: string, value: ";"}
          - {kind: new_line}
    - kind: for
      loc: 14/2
      control: {kind: var, decl: 2, name: "I"}
      elements:
        - kind: value
          value: {kind: int_const, type: integer, value: 5}
        - kind: value
          value: {kind: int_const, type: integer, value: 6}
        - kind: value
          value: {kind: int_const, type: integer, value: 7}
      body:
        kind: call
        loc: 14/3
        proc: 7
        name: "P"
        args:
          - kind: element
            type: string
            array: 1
            name: "L"
            subscripts:
              - {kind: var, type: integer, decl: 2, name: "I"}
