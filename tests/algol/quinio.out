  001               INTEGER FUNCTION XEEN(MASK)
  002               INTEGER N
  003               IF (MASK.EQ.31) GOTO 1
  004               IF (MASK.EQ.992) GOTO 2
  005               IF (MASK.EQ.-1) GOTO 3
  006               IF (MASK.EQ.33554432) GOTO 4
  007               WRITE (54, 100) MASK
  008          100  FORMAT(′ UNEXPECTED XEEN MASK ′,I10)
  009               STOP
  010            1  WRITE (54, 101)
  011          101  FORMAT(′ ENTER COLUMN: ′)
  012               READ (54, 200) N
  013          200  FORMAT(I2)
  014               IF (N.LE.0.OR.N.GT.31) GOTO 1
  015               XEEN = N
  016               RETURN
  017            2  WRITE (54, 102)
  018          102  FORMAT(′ ENTER ROW: ′)
  019               READ (54, 200) N
  020               IF (N.LE.0.OR.N.GT.31) GOTO 2
  021               XEEN = N*32
  022               RETURN
  023            3  WRITE (54, 103)
  024          103  FORMAT (′ ARE YOU SURE (1), OR NOT (0)↑′)
  025               READ (54, 200) N
  026               IF (N.NE.0.AND.N.NE.1) GOTO 3
  027               XEEN = N-1
  028               RETURN
  029            4  WRITE (54, 104)
  030          104  FORMAT (′ WHO PLAYS FIRST, YOU (1), OR I (
                                      0)↑′)
  031               READ (54, 200) N
  032               IF (N.NE.0.AND.N.NE.1) GOTO 3
  033               XEEN = N*33554432
  034               RETURN
  035               END


