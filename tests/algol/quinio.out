  001         C---------------------------------------
                    SUBROUTINE DRAW(BORD, NT, ZNR, COLOR, ROW,
                                       COL)
  002               DIMENSION L(4)
  003               DATA L/1HX ,1HO , 1H., 1H* /
  004               INTEGER BORD(NT, NT), ZNR, ROW, COL
  005               DIMENSION K(20)
  006               WRITE(54,99)ZNR,ROW,COL
  007            99 FORMAT(5H MOVE I3I50,1H-I2)
  008               WRITE(54, 100) (I,I=1,NT)
  009           100 FORMAT(9X20(I3))
  010               BORD(ROW,COL)=COLOR
  011               DO 1 I=1,NT
  012               DO 2 J=1,NT
  013             2 K(J)=L(BORD(I,J)+1)
              C   2 K(J)=BORD(I,J)
  014             1 WRITE(54,101) I,(K(J),J=1,NT)
  015           101 FORMAT(4XI3,2X(20(2XA1)))
  016               RETURN
  017               END

