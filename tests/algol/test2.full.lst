A L G O L - Г Д P
    (7.01.82)
           1. ′BEGIN′
           2.     ′COMMENT′ PROCEDURES, REALS, RECURSION, NA
               ME AND VALUE PARAMETERS;
           3.     ′REAL′ ′PROCEDURE′ F(X); ′VALUE′ X; ′REAL′
                X;
           4.         F := ′IF′ X < 1.0 ′THEN′ 1.0 ′ELSE′ X
               * F(X - 1.0);
           5.     ′INTEGER′ ′PROCEDURE′ SUM(I, A, B, T); ′VA
               LUE′ A, B;
           6.         ′INTEGER′ I, A, B, T;
           7.     ′BEGIN′ ′INTEGER′ S; S := 0;
           8.         ′FOR′ I := A ′STEP′ 1 ′UNTIL′ B ′DO′ S
                := S + T;
           9.         SUM := S
          10.     ′END′;
          11.     ′PROCEDURE′ SWAP(P, Q); ′REAL′ P, Q;
          12.     ′BEGIN′ ′REAL′ T; T := P; P := Q; Q := T ′
               END′;
          13.     ′INTEGER′ J; ′REAL′ U, V;
          14.     ′INTEGER′ ′ARRAY′ C[1:3];
          15.     U := 1.5; V := -0.00225;
          16.     SWAP(U, V);
          17.     PRINT(U, V, F(5.0), SUM(J, 1, 10, J*J));
          18.     PRINT(SQRT(2.0), SIN(1.0), COS(1.0));
          19.     PRINT(ARCTAN(1.0), LN(10.0), EXP(1.0));
          20.     PRINT(ABS(-3), SIGN(-2.0), ENTIER(3.7));
          21.     C[2] := ENTIER(7 / 2); PRINT(C[2], 7 / 2)
          22. ′END′
          23. ′EOP′
