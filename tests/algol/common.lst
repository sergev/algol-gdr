A L G O L - Г Д P
    (7.01.82)

     1.     _begin
     2.         _comment _common BLOCKS: SCALARS AND ARRAYS OF ONE TO THREE
     3.             DIMENSIONS, EXPORTED AS *ABC*, *DATA* AND *S*;
     4.         _common /ABC/ X, Y(10), Z(2,3);
     5.         _real X; _array Y[1:10]; _integer _array Z[1:2,1:3];
     6.         _common /DATA/ N, T(2, 2, 2).,
     7.         _integer N; _array T[1:2, 1:2, 1:2];
     8.         _common /S/ W;
     9.         _boolean W;
    10.         X := 1; Y[1] := 2; Z[2,3] := 3;
    11.         N := 4; T[2, 2, 2] := 5; W := _true;
    12.         PRINT(X, Y[1], Z[2,3], N, T[2, 2, 2], W);
    13.     _end

