c̲o̲m̲m̲e̲n̲t̲ SUM, EVEN, RANDOM, SETRANDOM, TIMEOFDAY of the X1 library;
b̲e̲g̲i̲n̲ i̲n̲t̲e̲g̲e̲r̲ i, j, k, n; r̲e̲a̲l̲ r, s; i̲n̲t̲e̲g̲e̲r̲ a̲r̲r̲a̲y̲ c[1 : 3];
    i̲n̲t̲e̲g̲e̲r̲ p̲r̲o̲c̲e̲d̲u̲r̲e̲ next; b̲e̲g̲i̲n̲ n := n + 1; next := n e̲n̲d̲;
    print(SUM(i, 1, 10, i), SUM(i, 1, 10, SUM(j, 1, i, j)), SUM(i, 5, 4, 1), i); NLCR;
    n := 0;
    print(SUM(i, 1, next + 2, n), n); NLCR;
    k := 2; c[1] := c[2] := c[3] := 0;
    print(SUM(c[k], 2, 4, c[k]), c[1], c[2], c[3]); NLCR;
    f̲o̲r̲ i := -3 s̲t̲e̲p̲ 1 u̲n̲t̲i̲l̲ 3 d̲o̲ b̲e̲g̲i̲n̲ print(EVEN(i)); SPACE(1) e̲n̲d̲;
    NLCR;
    SETRANDOM(0.5); r := RANDOM; s := RANDOM;
    SETRANDOM(0.5);
    print(i̲f̲ r = RANDOM ∧ s = RANDOM ∧ r ≠ s t̲h̲e̲n̲ 1 e̲l̲s̲e̲ 0);
    n := 0;
    f̲o̲r̲ i := 1 s̲t̲e̲p̲ 1 u̲n̲t̲i̲l̲ 1000 d̲o̲ b̲e̲g̲i̲n̲ r := RANDOM; i̲f̲ r ≥ 0 ∧ r < 1 t̲h̲e̲n̲ n := n + 1 e̲n̲d̲;
    print(n);
    r := TIMEOFDAY; print(i̲f̲ r ≥ 0 ∧ r < 86400 t̲h̲e̲n̲ 1 e̲l̲s̲e̲ 0); NLCR
e̲n̲d̲
