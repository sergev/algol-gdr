-- Abstract syntax of Algol 60, as the parser of algc reads it (src/parser.cpp,
-- the syntax tree in src/syntax.h): the Revised Report on the Algorithmic
-- Language Algol 60, with the extensions of Algol-GDR. Names are not resolved
-- and expressions have no types yet; the checker makes the AST of
-- doc/ast.asdl from this tree.
--
-- Marks in comments:
--   GDR   an extension of Algol-GDR, not in the Revised Report;
--   todo  in the Revised Report, not read by the parser yet (Milestone 3).
--
-- Concrete syntax, which the abstract syntax leaves out:
--  * Source is UTF-8. A keyword is '_' and a word, in any case: _begin,
--    _END; a blank or any other character ends it, so _real_array is two
--    keywords and _integer i needs the blank. In a file with underlined
--    letters (U+0332) an underlined word is a keyword too: b̲e̲g̲i̲n̲, g̲o̲ t̲o̲. Identifiers are Latin, Greek
--    or Cyrillic letters and digits ('_' is not one), of any length,
--    case-sensitive. Elsewhere outside strings blanks and line ends separate
--    nothing: "noun phrase" is the identifier "nounphrase", "1 000" is 1000.
--  * _comment … ; is skipped after ';' or _begin; text after _end is
--    skipped up to ';', _end or _else.
--  * Strings: `…' or ‘…’, which nest, the inner quotes kept. In `…', '` is
--    an apostrophe: `it'`s' is "it's". The strings of Algol-GDR, ''…'' and
--    '('…')', and strings in "…" are errors.
--  * Numbers: 12, 1.5, .5, 1⏨3, ⏨-2. A number ending in '.,' ends the
--    statement ('.,' is also ';').
--  * Operators, by priority from the lowest; all binary ones are left
--    associative:
--      1  ≡  _equiv
--      2  ⊃  _impl
--      3  ∨  _or
--      4  ∧  &  _and
--      5  ¬  _not                        (prefix)
--      6  < ≤ = ≠ ≥ >  _lt _le _eq _ne _ge _gt (_less, _notgreater,
--         _equal, _notequal, _notless, _greater)
--      7  + -                             (also prefix)
--      8  × * / ÷ _div
--      9  ↑ ^ ** _power
--  * Brackets [ ] may also be written (/ /), and the bounds of an array
--    declaration ( ).
--  * A conditional expression as an operand must be in parentheses. After
--    _then a conditional statement takes the _else (a warning), and a _for
--    statement there has no _else after it.
--  * Between parameters, in a call or a procedure heading, the delimiter
--    ") letter string: (" is a comma: p(a) size: (n).
--
module Algol60 {
    -- A program: _code: and _algol: lists of external procedures (GDR),
    -- _common declarations (GDR), then a block or compound statement, maybe
    -- labeled; or a unit of procedures compiled alone (GDR). Then the end of
    -- the file.
    Program = Program(External* externals, Decl* commons, Stmt body)
            | Unit(External* externals, Decl* commons, Decl* procedures)

    -- _code: _real f, g;   _algol: p;   (GDR)
    External = (identifier name, Type? type, ExternalKind kind)
    ExternalKind = Code     -- in machine code (Madlen, Fortran, …)
                 | Algol    -- compiled separately in Algol

    Type = Integer
         | Real
         | Boolean
         | String   -- GDR: a type of variables and arrays; in the Revised
                    -- Report only a specifier
         | Bits     -- GDR: octal words

    -- Declarations, at the head of a block or of the program.
    Decl = Vars(bool own, Type type, identifier* names)
         -- _array alone is _real _array
         | Arrays(bool own, Type type, ArraySegment* segments)
         -- _switch s := L1, L2, …
         | Switch(identifier name, Expr* elements)
         -- [type] _procedure p(formals); _value …; specifications; body
         | Procedure(Type? type, identifier name, identifier* formals,
                     identifier* values, Specification* specs, Stmt body)
         -- _common /block/ x, a(10, 20), …;   (GDR) sizes are constants
         | Common(identifier block, CommonElement* elements)
         attributes(int line)

    -- Arrays with the same bounds: a, b[1 : n, 0 : 9]
    ArraySegment = (identifier* names, BoundPair* bounds)
    BoundPair = (Expr lower, Expr upper)

    CommonElement = (identifier name, int* dims)   -- no dims: a variable

    -- A formal parameter is specified once at most; one called by value
    -- must be. The checker infers the kind of the others from their use.
    Specification = (Specifier specifier, identifier* names)
    Specifier = Simple(Type type)        -- includes _string
              | Array(Type type)         -- _array alone: _real _array
              | Procedure(Type? type)
              | Label
              | Switch

    Stmt = Block(Decl* decls, Stmt* body)        -- _begin decls; stmts _end
         | Compound(Stmt* body)                  -- _begin stmts _end
         -- an identifier or an unsigned integer (10:, the same as 010:)
         | Labeled(identifier label, Stmt stmt)
         | Dummy
         -- v := a[i] := e: targets are Var or Index; in a function body
         -- the function's name is a target too
         | Assign(Expr* targets, Expr value)
         | Goto(Expr target)                     -- a designational expression
         | If(Expr condition, Stmt then_stmt, Stmt? else_stmt)
         -- the controlled variable: Var or Index, its subscripts evaluated at
         -- each use
         | For(Expr var, ForElement* elements, Stmt body)
         -- p, or p(args): Var or Call
         | Call(Expr proc)
         -- GDR: _print (params) items, or _print param, items
         | Io(IoOp op, Expr* params, IoItem* items)
         attributes(int line, int stmt)          -- stmt: its number on the line

    ForElement = Value(Expr value)                              -- e
               | StepUntil(Expr init, Expr step, Expr limit)    -- e _step e _until e
               | While(Expr value, Expr condition)              -- e _while b

    -- GDR: input and output.
    IoOp = Read | Print | Punch | Write | Decode | Encode
         | Rewind | Backspace | Endfile                         -- no items
    IoItem = Item(Expr expr)
           | ForItem(identifier var, ForElement* elements, IoItem item)  -- _for v := … _do item

    -- Arithmetic, Boolean, string and designational expressions alike; an
    -- actual parameter is any of them, or an array, switch or procedure name.
    Expr = IntConst(int value)
         | RealConst(float value)
         | BitsConst(int value)          -- GDR: 'ddd', up to 16 octal digits
         | BoolConst(bool value)         -- _true, _false
         | StringConst(string value)
         -- a simple variable, a label, a function without parameters, or
         -- an array, switch or procedure as an actual parameter
         | Var(identifier name)
         -- a[i, j]; a switch designator s[i]; GDR: a character of a string
         | Index(identifier name, Expr* subscripts)
         | Slice(identifier name, Expr first, Expr last)   -- GDR: s[i : j]
         | Call(identifier name, Expr* args)               -- f(a, b)
         | Unary(UnaryOp op, Expr operand)
         | Binary(BinaryOp op, Expr left, Expr right)
         | If(Expr condition, Expr then_expr, Expr else_expr)
         attributes(int line)

    UnaryOp = Plus | Minus | Not

    BinaryOp = Add | Sub | Mul | Div
             | IntDiv                    -- ÷: integers, truncates toward zero
             | Power
             | Lt | Le | Eq | Ne | Ge | Gt
             | And | Or | Impl | Equiv
}
