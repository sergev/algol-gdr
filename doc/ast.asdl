-- AST of algc: an Algol-GDR program after scopes and type checks (pass 2).
--
-- Names are resolved: a declaration has an id unique in the program, and every
-- use refers to it (`int decl`), so the back end needs no scope rules. Implicit
-- conversions are explicit (Convert), and every expression has its type.
-- Codes in comments are the items of the pass-2 stream that make the node
-- (doc/passes.md, "Output stream").
--
-- Built by the checker (src/checker.cpp) from the syntax tree. A statement's
-- position is its line and the number of the statement on the line; a
-- declaration's, its line (stmt 0). Empty statements without a label are
-- dropped from statement lists. Names are UTF-8, as written in the source.
-- The text form (algc --dump-ast, tests/algol/*.ast) is YAML: a node is a
-- mapping with its constructor as `kind` (snake_case), then its fields;
-- a reference to a declaration also gives its `name`.
module AST {
    -- Where a statement starts: the line, and the statement on the line (from
    -- the statement markers 051), as in "NEXT STATEMENT IS l/s".
    SrcLoc = (int line, int stmt)

    -- _code and _algol procedures declared before the program, then its
    -- outer block. unit: procedures compiled alone, the declarations of the
    -- block, with no statements.
    Program = (External* externals, Stmt block, bool unit)

    External = (identifier name, int id, ExternalKind kind, Type type)   -- None: no value
    ExternalKind = Code | Algol

    Type = Integer | Real | Boolean | String
         | Bits     -- _bits: octal words, 48 bits
         | None     -- a procedure without a value

    -- Declarations of a block, or of the body of a procedure.
    -- own: one storage for all entries of the block, kept between them; the
    -- bounds of own arrays are evaluated at the first entry only.
    Decl = Var(identifier name, int id, Type type, bool own)
         -- a segment: arrays with the same bounds, evaluated once at block entry (040 … 0104)
         | Arrays(Type type, bool own, ArrayName* arrays, BoundPair* bounds)
         | Switch(identifier name, int id, Expr* elements)              -- 0146 0142/0144 … 0143
         | Label(identifier name, int id)
         | Procedure(identifier name, int id, Type type, Formal* formals, Stmt body)
         -- _common /name/ elements: they are declared in the same block, in this
         -- order; a variable is an array [1:1]
         | Common(identifier name, CommonElement* elements)
         attributes(SrcLoc loc)

    ArrayName = (identifier name, int id)

    BoundPair = (Expr lower, Expr upper)

    CommonElement = (identifier name, int decl, int size)   -- size in words

    -- A formal parameter: called by value (in the VALUE list) or by name.
    Formal = (identifier name, int id, Spec spec, bool by_value)

    Spec = Simple(Type type)
         | Array(Type type)
         | Procedure(Type type)
         | Label
         | Switch

    Stmt = Block(Decl* decls, Stmt* body)                           -- 036 … 037
         | Compound(Stmt* body)
         | Labeled(int label, Stmt stmt)                            -- 060
         | Dummy
         -- left parts from left to right; a real value to an integer is rounded (063)
         | Assign(LeftPart* targets, Expr value)                    -- 0100, 0101, 046
         | Goto(Expr target)                                        -- 026; target designational
         | If(Expr condition, Stmt then_stmt, Stmt? else_stmt)      -- 027, 0130-0134
         | For(LeftPart control, ForElement* elements, Stmt body)   -- 055 032/0141 … 033 … 052
         | Call(int proc, Expr* args)                               -- 020 … 0110; 0126 … 0121
         | StdProc(StdProc proc, Expr* args)                        -- 071, 072
         | Io(IoOp op, Expr* params, IoElement* items)              -- 063-074, 0100-0103
         attributes(SrcLoc loc)

    ForElement = Value(Expr value)                                  -- 056, 0136, 0135
               | StepUntil(Expr init, Expr step, Expr until)        -- 034, 0137, 0140
               | While(Expr value, Expr condition)                  -- 035

    -- A variable (a formal by name, or the result of the function whose body
    -- this is), or an array element.
    LeftPart = Var(int decl)
             | Element(int array, Expr* subscripts)

    -- Standard procedures used as statements.
    -- The IFIP procedures: the channel first; destinations are Var or Element.
    -- The X1 library: Print (numbers, any number of them) is print of the
    -- publication form; FLOT(n, x) is Flot(n, 2, x).
    StdProc = Stop | Load | LoadGo | Assign | Atos | Stoa
            | InInteger | InReal | InSymbol | OutInteger | OutReal | OutString
            | OutSymbol | OutTerminator | Fault
            | Print | PrintText | PrSym | Space | Tab | Nlcr | AbsFixt | Fixt | Flot
            | SetRandom

    -- I/O statements. The standard PRINT and READ are Print and Read (but
    -- print is X1's in the publication form, and read in an expression);
    -- the keywords _print and _write are Write.
    -- The params come before the list:
    --   Print, Punch: none;
    --   Read, Write: a unit and optionally a second one;
    --   Decode, Encode: three expressions; Rewind, Backspace, Endfile: the unit.
    IoOp = Print | Punch | Read | Write | Decode | Encode | Rewind | Backspace | Endfile

    IoElement = Item(Expr expr)
              | For(LeftPart control, ForElement* elements, IoElement* body)
              | NewLine
              | NewPage

    Expr = IntConst(int value)                                      -- 023
         | RealConst(float value)                                   -- 023
         | BoolConst(bool value)                                    -- 023 of TRUE, FALSE
         | BitsConst(int value)                                     -- 023 of an octal constant
         | StringConst(string value)                                -- 070
         -- the value of a variable or a formal by name, or a call of a function
         -- without parameters (017, 022, 021, 0107)
         | Var(int decl)
         | Element(int array, Expr* subscripts)                     -- 044; 045, 030 per subscript
         | Call(int proc, Expr* args)                               -- 020 … 0110
         | StdFunc(StdFunc func, Expr* args)                        -- 057
         | Unary(UnaryOp op, Expr operand)
         | Binary(BinaryOp op, Expr left, Expr right)
         | Cond(Expr condition, Expr then_expr, Expr else_expr)     -- 031 … 054
         | Convert(Conversion conv, Expr expr)                      -- 064, 063
         | StringElement(Expr string, Expr index)                   -- 0250
         | Slice(Expr string, Expr first, Expr last)                -- 050
         -- designational expressions: in GOTO, switches and arguments
         | LabelRef(int label)                                      -- 024
         | SwitchElement(int switch, Expr index)                    -- 025
         attributes(Type type)

    -- The X1 library: Read, Resym, Random, Timeofday without arguments; Xeen(n),
    -- Even(n); Sum(i, a, b, x) with i a Var or Element, x by name.
    StdFunc = Abs | Sign | Sqrt | Sin | Cos | Arctan | Ln | Exp | Entier | Length
            | Read | Resym | Xeen | Even | Random | Timeofday | Sum

    -- Neg: 047 real, 026 integer; Not: 004, 0204 on bits.
    UnaryOp = Neg | Not

    -- Arithmetic on integer and real operands of the node's type: 013-016, 067,
    -- 076, 077; Power: 0147-0153, 0347, 0350 (on bits by a constant: a shift,
    -- 0352). Add on strings concatenates. Relations on numbers, strings (0157),
    -- bits (Eq, Ne). And, Or, Not on Boolean operands and on bits (0203).
    BinaryOp = Add | Sub | Mul | Div | IntDiv | Power
             | Lt | Le | Eq | Ne | Ge | Gt
             | And | Or | Impl | Equiv

    -- IntToReal: 064, exact; RealToInt: 063, rounds to the nearest (floor of x + 1/2).
    Conversion = IntToReal | RealToInt
}
