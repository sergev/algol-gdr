#!/bin/sh
#
# Regenerate the passes translated from the overlay (scripts/gen-pass.py).
# Each pass gets its own copy of the shared code it calls: the driver's print
# routine 01644, the streams 27114, the formatter 27733, number to text 30001.
# Passes 2 and 3 are C++ and use shared_gen.cpp, the shared code alone.
#
set -e
cd "$(dirname "$(realpath "$0")")/.."
shared="01644-01735 27114-27244 27733-30000 30001-30033"
hooks="--hook 27114 --hook 27126 --hook 27137 --native 27733 --native 30001"
scripts/gen-pass.py $hooks shared $shared > src/shared_gen.cpp
scripts/gen-pass.py $hooks --replaced 23523-24136 --replaced 24221-24243 \
    --replaced 25276-25362 --replaced 26152-26157 pass4 23523-26257 $shared 30034-30117 > src/pass4_gen.cpp
