#!/bin/sh
#
# Copyright (c) 2026 Serge Vakulenko. MIT license.
#
# Run an object file (standard array cards) under dubna.
#
#   ref-run FILE.std
#
# Prints the job output without the banner and statistics.
# Optional NAME.run next to FILE.std: control cards placed before *execute
# (libraries, other modules).
# Optional NAME.in: terminal input of the program (default empty).
#
set -e
if [ $# -ne 1 ]; then
    echo "Usage: $0 FILE.std" >&2
    exit 2
fi
obj=$(realpath "$1")
name=$(basename "$1" .std)
run="${obj%.std}.run"
input="${obj%.std}.in"
[ -f "$input" ] || input=/dev/null
scripts=$(dirname "$(realpath "$0")")

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

{
    echo "*name $name"
    cat "$obj"
    [ -f "$run" ] && cat "$run"
    echo "*execute"
    echo "*end file"
} > "$work/job.dub"

(cd "$work" && dubna -r job.dub < "$input") | "$scripts/dubna-filter"
