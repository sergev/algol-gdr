#!/bin/sh
#
# Compile an Algol program with the original Algol-GDR under dubna.
#
#   ref-compile [--full] FILE.alg [OUTDIR]
#
# Writes OUTDIR/NAME.std (object cards) and OUTDIR/NAME.lst (NAME.full.lst
# with --full), the listing of a second job with *call setftn:one,long: one
# column, long lines, check mode. Exits 1 when no object was produced.
# Optional NAME.pre next to FILE.alg: control cards placed after *name.
#
set -e
full=
if [ "$1" = "--full" ]; then
    full=1
    shift
fi
if [ $# -lt 1 ] || [ $# -gt 2 ]; then
    echo "Usage: $0 [--full] FILE.alg [OUTDIR]" >&2
    exit 2
fi
src=$(realpath "$1")
outdir=$(realpath "${2:-$(dirname "$1")}")
name=$(basename "$1" .alg)
pre="${src%.alg}.pre"
scripts=$(dirname "$(realpath "$0")")

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

# The object from the job as given; *punch must come before *algol.
job() {
    echo "*name $name"
    [ -f "$pre" ] && cat "$pre"
    [ -n "$1" ] && echo "$1"
    echo "*punch"
    [ -n "$full" ] && echo "*full"
    echo "*algol"
    cat "$src"
    echo "*end file"
}
job > "$work/job.dub"
(cd "$work" && dubna -r job.dub > /dev/null)

# The listing in one column, long lines (in check mode, as setftn sets it).
mkdir "$work/l"
job "*call setftn:one,long" > "$work/l/job.dub"
(cd "$work/l" && dubna -r job.dub) | "$scripts/dubna-filter" > "$work/listing"

if [ -n "$full" ]; then
    cp "$work/listing" "$outdir/$name.full.lst"
else
    cp "$work/listing" "$outdir/$name.lst"
fi
if [ ! -s "$work/stdarray.out" ]; then
    echo "$name: no object produced" >&2
    exit 1
fi
cp "$work/stdarray.out" "$outdir/$name.std"
