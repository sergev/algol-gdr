#!/bin/sh
#
# Compile programs with the original Algol-GDR under a dubna memory trace, and
# write next to each FILE.alg the streams of passes 1-5 (FILE.s1 … FILE.s5) and
# the words each pass changed (FILE.mem). See capture-streams.py.
#
#   capture-streams FILE.alg...
#
set -e
scripts=$(dirname "$(realpath "$0")")
[ $# -ge 1 ] || { echo "Usage: $0 FILE.alg..." >&2; exit 2; }

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

for src in "$@"; do
    base=${src%.alg}
    name=$(basename "$base")
    pre="$base.pre"
    {
        echo "*name $name"
        [ -f "$pre" ] && cat "$pre"
        echo "*punch"
        echo "*algol"
        cat "$src"
        echo "*end file"
    } > "$work/job.dub"
    rm -f "$base".s[1-5] "$base.mem" "$work/trace"
    mkfifo "$work/trace"
    python3 "$scripts/capture-streams.py" "$work/trace" "$base" &
    (cd "$work" && dubna -r -d imer --trace=trace job.dub > /dev/null)
    wait $!
done
