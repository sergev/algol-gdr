#!/bin/sh
#
# Regenerate expected outputs of all test programs with the original compiler:
# NAME.std, NAME.lst, NAME.full.lst, NAME.out.
#
#   make-goldens [DIR]          (default tests/algol)
#
scripts=$(dirname "$(realpath "$0")")
dir=${1:-$scripts/../tests/algol}

for src in "$dir"/*.alg; do
    base=${src%.alg}
    name=$(basename "$base")
    rm -f "$base.std" "$base.out"
    "$scripts/ref-compile" --full "$src" > /dev/null 2>&1
    if "$scripts/ref-compile" "$src" 2> /dev/null; then
        if [ -f "$base.norun" ]; then
            echo "$name: compiled, not run"
        else
            timeout 60 "$scripts/ref-run" "$base.std" > "$base.out" ||
                echo "$name: run failed" >&2
            echo "$name: ok"
        fi
    else
        echo "$name: compile errors"
    fi
done
